---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { categories } from '../data/categories';
import { products } from '../data/products';
---

<!doctype html>

<html lang="en">

	<head>

		<BaseHead
			title="Merch"
			description="Artwork, clothing and other merchandise."
		/>

	</head>


	<body>

		<Header />


		<main class="merch-page">


			<!-- PAGE HEADING -->

			<section class="page-heading">

				<h1>
					Merch
				</h1>

				<p>
					Artwork, clothing and other goodies.
				</p>

			</section>



			<!-- CATEGORY GRID -->

			<section class="category-grid">

				{categories.map((category) => {

					const categoryProducts =
						products.filter(
							(product) =>
								product.category === category.slug
						);

					return (

						<a
							href={`/merch/${category.slug}`}
							class="category-card"
						>


							<div class="category-image">

								<img
									src={category.image}
									alt={category.name}
								/>

							</div>


							<div class="category-info">

								<p class="category-label">
									Merch
								</p>


								<h2>
									{category.name}
								</h2>


								<p class="category-description">
									{category.description}
								</p>


								<div class="category-bottom">

									<span>
										{categoryProducts.length}
										{categoryProducts.length === 1
											? ' product'
											: ' products'}
									</span>


									<span class="category-arrow">
										→
									</span>

								</div>

							</div>

						</a>

					);

				})}

			</section>


		</main>


		<Footer />

	</body>

</html>



<style>

	/* =========================
	   PAGE
	   ========================= */

	.merch-page {

		max-width: 1000px;

		margin: 0 auto;

		padding:
			4rem 1.5rem
			6rem;

	}



	/* =========================
	   HEADING
	   ========================= */

	.page-heading {

		text-align: center;

		margin-bottom: 3rem;

	}


	.page-heading h1 {

		margin: 0;

		font-size:
			clamp(3rem, 8vw, 5rem);

		line-height: 1;

		letter-spacing:
			-0.03em;

	}


	.page-heading p {

		margin:
			1rem 0 0;

		color:
			var(--text-muted);

		font-size:
			1rem;

	}



	/* =========================
	   CATEGORY GRID
	   ========================= */

	.category-grid {

		display: grid;

		grid-template-columns:
			repeat(2, 1fr);

		gap:
			1.5rem;

	}



	/* =========================
	   CATEGORY CARD
	   ========================= */

	.category-card {

		display: block;

		overflow: hidden;

		border-radius:
			24px;

		border:
			1px solid
			rgba(255, 130, 225, 0.35);

		background:
			linear-gradient(
				145deg,
				rgba(180, 20, 150, 0.16),
				rgba(40, 10, 50, 0.24)
			);

		color:
			white;

		text-decoration:
			none;

		box-shadow:
			0 0 15px
			rgba(255, 80, 200, 0.08);

		transition:
			transform 0.25s ease,
			border-color 0.25s ease,
			box-shadow 0.25s ease;

	}


	.category-card:hover {

		transform:
			translateY(-6px);

		border-color:
			rgba(255, 130, 225, 0.9);

		box-shadow:

			0 0 25px
			rgba(255, 80, 200, 0.35),

			0 0 60px
			rgba(255, 80, 200, 0.12);

	}



	/* =========================
	   CATEGORY IMAGE
	   ========================= */

	.category-image {

		width:
			100%;

		aspect-ratio:
			16 / 9;

		overflow:
			hidden;

		background:
			rgba(255, 255, 255, 0.03);

	}


	.category-image img {

		width:
			100%;

		height:
			100%;

		display:
			block;

		object-fit:
			cover;

		transition:
			transform 0.3s ease;

	}


	.category-card:hover
	.category-image img {

		transform:
			scale(1.03);

	}



	/* =========================
	   CATEGORY INFORMATION
	   ========================= */

	.category-info {

		padding:
			1.3rem
			1.4rem
			1.5rem;

	}


	.category-label {

		margin:
			0 0 0.4rem;

		color:
			var(--pink-light);

		font-size:
			0.7rem;

		font-weight:
			600;

		letter-spacing:
			0.1em;

		text-transform:
			uppercase;

	}


	.category-info h2 {

		margin:
			0;

		font-size:
			1.5rem;

		line-height:
			1.2;

	}


	.category-description {

		margin:
			0.7rem 0 0;

		color:
			var(--text-muted);

		font-size:
			0.9rem;

		line-height:
			1.5;

	}


	/* =========================
	   BOTTOM ROW
	   ========================= */

	.category-bottom {

		display:
			flex;

		align-items:
			center;

		justify-content:
			space-between;

		margin-top:
			1.2rem;

		color:
			rgba(255, 255, 255, 0.65);

		font-size:
			0.8rem;

	}


	.category-arrow {

		font-size:
			1.2rem;

		color:
			var(--pink-light);

		transition:
			transform 0.2s ease;

	}


	.category-card:hover
	.category-arrow {

		transform:
			translateX(5px);

	}



	/* =========================
	   MOBILE
	   ========================= */

	@media (max-width: 700px) {

		.merch-page {

			padding:
				2.5rem 0.8rem
				4rem;

		}


		.category-grid {

			grid-template-columns:
				1fr;

			gap:
				1rem;

		}


		.category-info {

			padding:
				1.1rem
				1.2rem
				1.3rem;

		}


		.category-info h2 {

			font-size:
				1.3rem;

		}

	}

</style>
