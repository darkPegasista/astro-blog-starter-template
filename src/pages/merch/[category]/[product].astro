---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { categories } from '../../../data/categories';
import { products } from '../../../data/products';

export function getStaticPaths() {

	return products.map((product) => {

		const category = categories.find(
			(category) =>
				category.slug === product.category
		);

		return {
			params: {
				category: product.category,
				product: product.slug,
			},

			props: {
				product,
				category,
			},
		};

	});

}

const { product, category } = Astro.props;
---

<!doctype html>

<html lang="en">

	<head>

		<BaseHead
			title={product.name}
			description={`Shop ${product.name}`}
		/>

	</head>


	<body>

		<Header />


		<main class="product-page">


			<!-- BREADCRUMB -->

			<nav class="breadcrumb">

				<a href="/merch">
					Merch
				</a>

				<span>/</span>

				<a href={`/merch/${category.slug}`}>
					{category.name}
				</a>

				<span>/</span>

				<span>
					{product.name}
				</span>

			</nav>



			<!-- PRODUCT -->

			<section class="product-layout">


				<!-- IMAGE -->

				<div class="product-gallery">

	<!-- MAIN IMAGE -->

	<button
		type="button"
		class="main-product-image"
		id="main-image-button"
		aria-label={`View ${product.name} image`}
	>

		<img
			id="main-product-image"
			src={product.images[0]}
			alt={product.name}
		/>

		<span class="zoom-indicator">
			↗
		</span>

	</button>


	<!-- THUMBNAILS -->

	<div
		class="product-thumbnails"
		role="list"
	>

		{product.images.map((image, index) => (

			<button
				type="button"
				class:list={{ active: index === 0 }}
				class="product-thumbnail"
				data-index={index}
				aria-label={`View image ${index + 1}`}
			>

				<img
					src={image}
					alt={`${product.name} image ${index + 1}`}
				/>

			</button>

		))}

	</div>

</div>



				<!-- PRODUCT INFORMATION -->

				<div class="product-details">

					<p class="product-category">
						{category.name}
					</p>


					<h1>
						{product.name}
					</h1>


					<p class="price">
						€{product.price.toFixed(2)}
					</p>


					<div class="stock">

						{product.stock > 0 ? (

							<span>
								✓ In stock
							</span>

						) : (

							<span class="sold-out">
								Sold out
							</span>

						)}

					</div>



					<!-- QUANTITY -->

					{product.stock > 0 && (

						<div class="quantity-section">

							<label for="quantity">
								Quantity
							</label>

							<div class="quantity-control">

								<button
									type="button"
									id="quantity-minus"
								>
									−
								</button>

								<span id="quantity">
									1
								</span>

								<button
									type="button"
									id="quantity-plus"
								>
									+
								</button>

							</div>

						</div>

					)}



					<!-- ADD TO CART -->

					{product.stock > 0 ? (

						<button
							type="button"
							class="add-to-cart"
							id="add-to-cart"
						>
							Add to cart
						</button>

					) : (

						<button
							type="button"
							class="add-to-cart disabled"
							disabled
						>
							Sold out
						</button>

					)}

				</div>

			</section>



			<!-- PRODUCT INFORMATION -->

			<section class="product-information">


				<div class="information-block">

					<h2>
						Description
					</h2>

					<p>
						{product.description ??
							'Product description coming soon.'}
					</p>

				</div>



				<div class="information-block">

					<h2>
						Material
					</h2>

					<p>
						{product.material ??
							'Material information coming soon.'}
					</p>

				</div>



				<div class="information-block">

					<h2>
						Shipping
					</h2>

					<p>
						Shipping information coming soon.
					</p>

				</div>


			</section>


		</main>


<!-- LIGHTBOX -->

<div
	id="image-lightbox"
	class="image-lightbox"
	aria-hidden="true"
>

	<button
		type="button"
		class="lightbox-close"
		id="lightbox-close"
		aria-label="Close image viewer"
	>
		×
	</button>


	<button
		type="button"
		class="lightbox-arrow lightbox-previous"
		id="lightbox-previous"
		aria-label="Previous image"
	>
		←
	</button>


	<div class="lightbox-content">

		<img
			id="lightbox-image"
			src={product.images[0]}
			alt={product.name}
		/>

		<div
			id="lightbox-counter"
			class="lightbox-counter"
		>
			1 / {product.images.length}
		</div>

	</div>


	<button
		type="button"
		class="lightbox-arrow lightbox-next"
		id="lightbox-next"
		aria-label="Next image"
	>
		→
	</button>

</div>


<Footer />


		<!-- QUANTITY SCRIPT -->

		<script>

			const minus =
				document.querySelector('#quantity-minus');

			const plus =
				document.querySelector('#quantity-plus');

			const quantity =
				document.querySelector('#quantity');

			const addToCart =
				document.querySelector('#add-to-cart');


			let currentQuantity = 1;


			minus?.addEventListener(
				'click',
				() => {

					if (currentQuantity > 1) {

						currentQuantity--;

						if (quantity) {
							quantity.textContent =
								String(currentQuantity);
						}

					}

				}
			);


			plus?.addEventListener(
				'click',
				() => {

					currentQuantity++;

					if (quantity) {
						quantity.textContent =
							String(currentQuantity);
					}

				}
			);


			addToCart?.addEventListener(
				'click',
				() => {

					alert(
						'Shopping cart coming soon!'
					);

				}
			);
// =========================
// PRODUCT IMAGE GALLERY
// =========================

const productImages = [
	{product.images.map((image) => `'${image}'`).join(',\n\t\t\t')}
];

const mainImage =
	document.querySelector('#main-product-image');

const mainImageButton =
	document.querySelector('#main-image-button');

const thumbnails =
	document.querySelectorAll('.product-thumbnail');

const lightbox =
	document.querySelector('#image-lightbox');

const lightboxImage =
	document.querySelector('#lightbox-image');

const lightboxCounter =
	document.querySelector('#lightbox-counter');

const lightboxClose =
	document.querySelector('#lightbox-close');

const lightboxPrevious =
	document.querySelector('#lightbox-previous');

const lightboxNext =
	document.querySelector('#lightbox-next');


let currentImage = 0;



function showImage(index) {

	currentImage =
		(index + productImages.length)
		% productImages.length;


	if (mainImage) {

		mainImage.src =
			productImages[currentImage];

	}


	if (lightboxImage) {

		lightboxImage.src =
			productImages[currentImage];

	}


	if (lightboxCounter) {

		lightboxCounter.textContent =
			`${currentImage + 1} / ${productImages.length}`;

	}


	thumbnails.forEach((thumbnail, index) => {

		thumbnail.classList.toggle(
			'active',
			index === currentImage
		);

	});

}



thumbnails.forEach((thumbnail) => {

	thumbnail.addEventListener(
		'click',
		() => {

			const index =
				Number(
					thumbnail.getAttribute(
						'data-index'
					)
				);

			showImage(index);

		}
	);

});



function openLightbox() {

	showImage(currentImage);

	lightbox?.classList.add('open');

	lightbox?.setAttribute(
		'aria-hidden',
		'false'
	);

	document.body.style.overflow =
		'hidden';

}



function closeLightbox() {

	lightbox?.classList.remove('open');

	lightbox?.setAttribute(
		'aria-hidden',
		'true'
	);

	document.body.style.overflow =
		'';

}



mainImageButton?.addEventListener(
	'click',
	openLightbox
);


lightboxClose?.addEventListener(
	'click',
	closeLightbox
);


lightboxPrevious?.addEventListener(
	'click',
	() => {

		showImage(currentImage - 1);

	}
);


lightboxNext?.addEventListener(
	'click',
	() => {

		showImage(currentImage + 1);

	}
);



lightbox?.addEventListener(
	'click',
	(event) => {

		if (event.target === lightbox) {

			closeLightbox();

		}

	}
);



document.addEventListener(
	'keydown',
	(event) => {

		if (!lightbox?.classList.contains('open')) {
			return;
		}


		if (event.key === 'Escape') {

			closeLightbox();

		}


		if (event.key === 'ArrowLeft') {

			showImage(currentImage - 1);

		}


		if (event.key === 'ArrowRight') {

			showImage(currentImage + 1);

		}

	}
);

		</script>

	</body>

</html>



<style>

	/* =========================
	   PAGE
	   ========================= */

	.product-page {

		max-width: 1000px;

		margin: 0 auto;

		padding:
			2rem 1.5rem
			6rem;

	}



	/* =========================
	   BREADCRUMB
	   ========================= */

	.breadcrumb {

		display: flex;

		align-items: center;

		justify-content: center;

		flex-wrap: wrap;

		gap: 0.6rem;

		margin-bottom: 3rem;

		color:
			rgba(255, 255, 255, 0.4);

		font-size:
			0.8rem;

	}


	.breadcrumb a {

		color:
			var(--pink-light);

		text-decoration:
			none;

	}


	.breadcrumb a:hover {

		color: white;

	}



	/* =========================
	   PRODUCT LAYOUT
	   ========================= */

	.product-layout {

		display: grid;

		grid-template-columns:
			1.1fr 0.9fr;

		gap:
			4rem;

		align-items:
			start;

	}



	/* =========================
	   PRODUCT IMAGE
	   ========================= */

	.product-image {

		width:
			100%;

		aspect-ratio:
			4 / 3;

		overflow:
			hidden;

		border-radius:
			24px;

		border:
			1px solid
			rgba(255, 130, 225, 0.35);

		background:
			rgba(255, 255, 255, 0.03);

		box-shadow:
			0 0 25px
			rgba(255, 80, 200, 0.1);

	}


	.product-image img {

		width:
			100%;

		height:
			100%;

		display:
			block;

		object-fit:
			cover;

	}



	/* =========================
	   DETAILS
	   ========================= */

	.product-details {

		padding-top:
			0.5rem;

	}


	.product-category {

		margin:
			0 0 0.5rem;

		color:
			var(--pink-light);

		font-size:
			0.75rem;

		font-weight:
			600;

		letter-spacing:
			0.1em;

		text-transform:
			uppercase;

	}


	.product-details h1 {

		margin:
			0;

		font-size:
			clamp(2rem, 5vw, 3.5rem);

		line-height:
			1.05;

	}


	.price {

		margin:
			1.2rem 0 0;

		font-size:
			1.5rem;

		font-weight:
			700;

	}


	.stock {

		margin-top:
			1rem;

		color:
			rgba(255, 255, 255, 0.7);

		font-size:
			0.85rem;

	}


	.sold-out {

		color:
			var(--pink-light);

	}



	/* =========================
	   QUANTITY
	   ========================= */

	.quantity-section {

		margin-top:
			2rem;

	}


	.quantity-section label {

		display:
			block;

		margin-bottom:
			0.6rem;

		font-size:
			0.8rem;

		font-weight:
			600;

	}


	.quantity-control {

		display:
			flex;

		align-items:
			center;

		width:
			fit-content;

		border:
			1px solid
			rgba(255, 130, 225, 0.45);

		border-radius:
			10px;

		overflow:
			hidden;

	}


	.quantity-control button {

		width:
			42px;

		height:
			42px;

		border:
			none;

		background:
			rgba(255, 255, 255, 0.04);

		color:
			white;

		font-size:
			1.2rem;

		cursor:
			pointer;

	}


	.quantity-control button:hover {

		background:
			rgba(255, 80, 200, 0.15);

	}


	.quantity-control span {

		width:
			45px;

		text-align:
			center;

		font-weight:
			600;

	}



	/* =========================
	   ADD TO CART
	   ========================= */

	.add-to-cart {

		width:
			100%;

		margin-top:
			1.5rem;

		padding:
			1rem;

		border:
			1px solid
			rgba(255, 130, 225, 0.7);

		border-radius:
			12px;

		background:
			rgba(255, 70, 200, 0.12);

		color:
			white;

		font-family:
			inherit;

		font-size:
			1rem;

		font-weight:
			700;

		cursor:
			pointer;

		box-shadow:
			0 0 15px
			rgba(255, 80, 200, 0.12);

		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease,
			background 0.2s ease;

	}


	.add-to-cart:hover {

		transform:
			translateY(-2px);

		background:
			rgba(255, 70, 200, 0.2);

		box-shadow:
			0 0 25px
			rgba(255, 80, 200, 0.3);

	}


	.add-to-cart.disabled {

		opacity:
			0.4;

		cursor:
			not-allowed;

	}



	/* =========================
	   INFORMATION
	   ========================= */

	.product-information {

		margin-top:
			5rem;

	}


	.information-block {

		padding:
			1.5rem 0;

		border-top:
			1px solid
			rgba(255, 130, 225, 0.2);

	}


	.information-block h2 {

		margin:
			0 0 0.7rem;

		font-size:
			1.1rem;

	}


	.information-block p {

		max-width:
			750px;

		margin:
			0;

		color:
			var(--text-muted);

		font-size:
			0.95rem;

		line-height:
			1.6;

	}



	/* =========================
	   MOBILE
	   ========================= */

	@media (max-width: 750px) {

		.product-page {

			padding:
				1.5rem 0.8rem
				4rem;

		}


		.product-layout {

			grid-template-columns:
				1fr;

			gap:
				2rem;

		}


		.product-details {

			padding:
				0 0.2rem;

		}


		.product-details h1 {

			font-size:
				2.3rem;

		}


		.product-information {

			margin-top:
				3rem;

		}

	}

</style>
