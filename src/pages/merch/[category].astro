---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { categories } from '../../data/categories';
import { products } from '../../data/products';

export function getStaticPaths() {
	return categories.map((category) => ({
		params: {
			category: category.slug,
		},
		props: {
			category,
		},
	}));
}

const { category } = Astro.props;

const categoryProducts = products.filter(
	(product) => product.category === category.slug
);
---

<!doctype html>

<html lang="en">

	<head>

		<BaseHead
			title={category.name}
			description={category.description}
		/>

	</head>


	<body>

		<Header />


		<main class="category-page">


			<!-- =========================
			     BREADCRUMB
			     ========================= -->

			<nav class="breadcrumb">

				<a href="/merch">
					Merch
				</a>

				<span>/</span>

				<span>
					{category.name}
				</span>

			</nav>



			<!-- =========================
			     PAGE HEADING
			     ========================= -->

			<section class="page-heading">

				<h1>
					{category.name}
				</h1>

				<p>
					{category.description}
				</p>

			</section>



			<!-- =========================
			     PRODUCTS
			     ========================= -->

			<section class="product-grid">

				{categoryProducts.map((product) => (

					<article
						class="product-card"
						data-slug={product.slug}
						data-name={product.name}
						data-price={product.price}
						data-stock={product.stock}
						data-image={product.image}
					>


						<!-- =========================
						     PRODUCT LINK
						     ========================= -->

						<a
							href={`/merch/${category.slug}/${product.slug}`}
							class="product-link"
						>

							<div class="product-image">

								<img
									src={product.image}
									alt={product.name}
								/>

							</div>


							<div class="product-info">

								<p class="product-category">
									{product.category.replace('-', ' ')}
								</p>


								<h2>
									{product.name}
								</h2>


								<div class="product-bottom">

									<span class="price">
										€{product.price.toFixed(2)}
									</span>


									{product.stock > 0 ? (

										<span class="stock">
											✓ In stock
										</span>

									) : (

										<span class="sold-out">
											Sold out
										</span>

									)}

								</div>

							</div>

						</a>



						<!-- =========================
						     QUANTITY + CART
						     ========================= -->

						{product.stock > 0 && (

							<div class="cart-controls">


								<div class="quantity-section">

									<span class="quantity-label">
										Quantity
									</span>


									<div class="quantity-control">

										<button
											type="button"
											class="quantity-minus"
											aria-label={`Decrease quantity of ${product.name}`}
										>
											−
										</button>


										<span class="quantity-value">
											1
										</span>


										<button
											type="button"
											class="quantity-plus"
											aria-label={`Increase quantity of ${product.name}`}
										>
											+
										</button>

									</div>

								</div>



								<button
									type="button"
									class="add-to-cart"
								>
									Add to cart
								</button>

							</div>

						)}

					</article>

				))}

			</section>


		</main>


		<Footer />



		<!-- =========================
		     SCRIPTS
		     ========================= -->

		<script>

			// =========================
			// CART COUNT
			// =========================

			function updateCartCount() {

				let cart = [];

				try {

					cart =
						JSON.parse(
							localStorage.getItem('cart') ||
							'[]'
						);

				} catch {

					cart = [];

				}


				const totalItems =
					cart.reduce(
						(total, item) =>
							total + item.quantity,
						0
					);


				const cartCount =
					document.querySelector(
						'#cart-count'
					);


				if (cartCount) {

					cartCount.textContent =
						String(totalItems);

				}

			}


			updateCartCount();



			// =========================
			// PRODUCT CARDS
			// =========================

			document
				.querySelectorAll('.product-card')
				.forEach((card) => {

					const stock =
						Number(
							card.getAttribute(
								'data-stock'
							)
						);


					const slug =
						card.getAttribute(
							'data-slug'
						);


					const name =
						card.getAttribute(
							'data-name'
						);


					const price =
						Number(
							card.getAttribute(
								'data-price'
							)
						);


					const image =
						card.getAttribute(
							'data-image'
						);


					const quantityValue =
						card.querySelector(
							'.quantity-value'
						);


					const minus =
						card.querySelector(
							'.quantity-minus'
						);


					const plus =
						card.querySelector(
							'.quantity-plus'
						);


					const addToCart =
						card.querySelector(
							'.add-to-cart'
						);


					let currentQuantity = 1;



					// =========================
					// UPDATE QUANTITY DISPLAY
					// =========================

					function updateQuantity() {

						if (quantityValue) {

							quantityValue.textContent =
								String(currentQuantity);

						}

					}



					// =========================
					// DECREASE
					// =========================

					minus?.addEventListener(
						'click',
						(event) => {

							event.preventDefault();
							event.stopPropagation();


							if (
								currentQuantity > 1
							) {

								currentQuantity--;

								updateQuantity();

							}

						}
					);



					// =========================
					// INCREASE
					// =========================

					plus?.addEventListener(
						'click',
						(event) => {

							event.preventDefault();
							event.stopPropagation();


							if (
								currentQuantity < stock
							) {

								currentQuantity++;

								updateQuantity();

							}

						}
					);



					// =========================
					// ADD TO CART
					// =========================

					addToCart?.addEventListener(
						'click',
						(event) => {

							event.preventDefault();
							event.stopPropagation();


							let cart = [];


							try {

								cart =
									JSON.parse(
										localStorage.getItem(
											'cart'
										) ||
										'[]'
									);

							} catch {

								cart = [];

							}



							// Find existing product

							const existingItem =
								cart.find(
									(item) =>
										item.slug ===
										slug
								);



							// =========================
							// EXISTING PRODUCT
							// =========================

							if (existingItem) {

								existingItem.quantity =
									Math.min(
										existingItem.quantity +
										currentQuantity,
										stock
									);

							}



							// =========================
							// NEW PRODUCT
							// =========================

							else {

								cart.push({

									slug:
										slug,

									name:
										name,

									price:
										price,

									image:
										image,

									quantity:
										Math.min(
											currentQuantity,
											stock
										)

								});

							}



							// =========================
							// SAVE CART
							// =========================

							localStorage.setItem(
								'cart',
								JSON.stringify(cart)
							);


							updateCartCount();



							// =========================
							// BUTTON FEEDBACK
							// =========================

							const originalText =
								addToCart.textContent;


							addToCart.textContent =
								'✓ Added to cart';


							addToCart.classList.add(
								'added'
							);


							setTimeout(
								() => {

									addToCart.textContent =
										originalText;

									addToCart.classList.remove(
										'added'
									);

								},
								1500
							);

						}

					);

				});

		</script>

	</body>

</html>



<style>

	/* =========================
	   PAGE
	   ========================= */

	.category-page {

		max-width: 1000px;

		margin: 0 auto;

		padding:
			2rem 1.5rem
			6rem;

	}



	/* =========================
	   BREADCRUMB
	   ========================= */

	.breadcrumb {

		display: flex;

		align-items: center;

		justify-content: center;

		gap: 0.6rem;

		margin-bottom: 3rem;

		color:
			rgba(255, 255, 255, 0.4);

		font-size: 0.8rem;

	}


	.breadcrumb a {

		color:
			var(--pink-light);

		text-decoration: none;

		transition:
			color 0.2s ease;

	}


	.breadcrumb a:hover {

		color: white;

	}



	/* =========================
	   HEADING
	   ========================= */

	.page-heading {

		text-align: center;

		margin-bottom: 3rem;

	}


	.page-heading h1 {

		margin: 0;

		font-size:
			clamp(2.5rem, 7vw, 4.5rem);

		line-height: 1;

		letter-spacing:
			-0.03em;

	}


	.page-heading p {

		max-width: 600px;

		margin:
			1rem auto 0;

		color:
			var(--text-muted);

		font-size:
			1rem;

		line-height:
			1.5;

	}



	/* =========================
	   PRODUCT GRID
	   ========================= */

	.product-grid {

		display: grid;

		grid-template-columns:
			repeat(3, 1fr);

		gap:
			1.5rem;

	}



	/* =========================
	   PRODUCT CARD
	   ========================= */

	.product-card {

		overflow: hidden;

		border-radius:
			22px;

		border:
			1px solid
			rgba(255, 130, 225, 0.35);

		background:
			linear-gradient(
				145deg,
				rgba(180, 20, 150, 0.16),
				rgba(40, 10, 50, 0.24)
			);

		color:
			white;

		box-shadow:
			0 0 15px
			rgba(255, 80, 200, 0.08);

		transition:
			transform 0.25s ease,
			border-color 0.25s ease,
			box-shadow 0.25s ease;

	}


	.product-card:hover {

		transform:
			translateY(-5px);

		border-color:
			rgba(255, 130, 225, 0.9);

		box-shadow:

			0 0 25px
			rgba(255, 80, 200, 0.35),

			0 0 55px
			rgba(255, 80, 200, 0.12);

	}



	/* =========================
	   PRODUCT LINK
	   ========================= */

	.product-link {

		display:
			block;

		color:
			white;

		text-decoration:
			none;

	}



	/* =========================
	   IMAGE
	   ========================= */

	.product-image {

		width:
			100%;

		aspect-ratio:
			4 / 3;

		overflow:
			hidden;

	}


	.product-image img {

		width:
			100%;

		height:
			100%;

		display:
			block;

		object-fit:
			cover;

		transition:
			transform 0.3s ease;

	}


	.product-card:hover
	.product-image img {

		transform:
			scale(1.03);

	}



	/* =========================
	   PRODUCT INFORMATION
	   ========================= */

	.product-info {

		padding:
			1.2rem
			1.3rem
			0.8rem;

	}


	.product-category {

		margin:
			0 0 0.35rem;

		color:
			var(--pink-light);

		font-size:
			0.7rem;

		font-weight:
			600;

		letter-spacing:
			0.08em;

		text-transform:
			uppercase;

	}


	.product-info h2 {

		margin:
			0;

		font-size:
			1.15rem;

		line-height:
			1.3;

	}


	.product-bottom {

		display:
			flex;

		align-items:
			center;

		justify-content:
			space-between;

		gap:
			1rem;

		margin-top:
			1rem;

	}


	.price {

		font-size:
			1.2rem;

		font-weight:
			700;

	}


	.stock {

		color:
			rgba(255, 255, 255, 0.65);

		font-size:
			0.8rem;

	}


	.sold-out {

		color:
			rgba(255, 130, 225, 0.8);

		font-size:
			0.8rem;

		font-weight:
			600;

	}



	/* =========================
	   CART CONTROLS
	   ========================= */

	.cart-controls {

		display:
			flex;

		align-items:
			end;

		gap:
			0.8rem;

		padding:
			0.8rem 1.3rem 1.3rem;

	}


	.quantity-section {

		flex:
			0 0 auto;

	}


	.quantity-label {

		display:
			block;

		margin-bottom:
			0.35rem;

		color:
			var(--text-muted);

		font-size:
			0.7rem;

		font-weight:
			600;

	}


	.quantity-control {

		display:
			flex;

		align-items:
			center;

		border:
			1px solid
			rgba(255, 130, 225, 0.4);

		border-radius:
			9px;

		overflow:
			hidden;

	}


	.quantity-control button {

		width:
			34px;

		height:
			36px;

		padding:
			0;

		border:
			none;

		background:
			rgba(255, 255, 255, 0.04);

		color:
			white;

		font-family:
			inherit;

		font-size:
			1rem;

		cursor:
			pointer;

	}


	.quantity-control button:hover {

		background:
			rgba(255, 80, 200, 0.15);

	}


	.quantity-value {

		width:
			32px;

		text-align:
			center;

		font-size:
			0.85rem;

		font-weight:
			600;

	}



	/* =========================
	   ADD TO CART
	   ========================= */

	.add-to-cart {

		flex:
			1;

		min-width:
			0;

		height:
			36px;

		padding:
			0 0.7rem;

		border:
			1px solid
			rgba(255, 130, 225, 0.6);

		border-radius:
			9px;

		background:
			rgba(255, 70, 200, 0.1);

		color:
			white;

		font-family:
			inherit;

		font-size:
			0.8rem;

		font-weight:
			700;

		cursor:
			pointer;

		transition:
			background 0.2s ease,
			box-shadow 0.2s ease,
			transform 0.2s ease;

	}


	.add-to-cart:hover {

		transform:
			translateY(-1px);

		background:
			rgba(255, 70, 200, 0.2);

		box-shadow:
			0 0 18px
			rgba(255, 80, 200, 0.25);

	}


	.add-to-cart.added {

		background:
			rgba(255, 100, 220, 0.25);

		box-shadow:
			0 0 20px
			rgba(255, 80, 200, 0.3);

	}



	/* =========================
	   MOBILE
	   ========================= */

	@media (max-width: 750px) {

		.category-page {

			padding:
				1.5rem 0.8rem
				4rem;

		}


		.product-grid {

			grid-template-columns:
				repeat(2, 1fr);

			gap:
				1rem;

		}


		.product-info {

			padding:
				1rem
				1rem
				0.6rem;

		}


		.product-info h2 {

			font-size:
				1rem;

		}


		.product-bottom {

			align-items:
				flex-start;

			flex-direction:
				column;

			gap:
				0.3rem;

		}


		.cart-controls {

			flex-direction:
				column;

			align-items:
				stretch;

			padding:
				0.7rem 1rem 1rem;

		}


		.quantity-section {

			width:
				100%;

		}


		.quantity-control {

			width:
				100%;

		}


		.quantity-control button {

			flex:
				1;

		}


		.quantity-value {

			flex:
				0 0 45px;

		}


		.add-to-cart {

			width:
				100%;

		}

	}



	@media (max-width: 480px) {

		.product-grid {

			grid-template-columns:
				1fr;

		}


		.cart-controls {

			flex-direction:
				row;

			align-items:
				end;

		}


		.quantity-section {

			width:
				auto;

		}


		.quantity-control {

			width:
				auto;

		}


		.quantity-control button {

			flex:
				none;

		}

	}

</style>
