---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>

<html lang="en">

	<head>

		<BaseHead
			title="Imprint / Impressum"
			description="Legal information and provider identification for lunar visuals."
		/>

	</head>


	<body>

		<Header />


		<main class="legal-page">


			<!-- =========================
			     PAGE HEADING
			     ========================= -->

			<section class="page-heading">

				<p class="eyebrow">
					✦ LEGAL INFORMATION ✦
				</p>

				<h1>
					Imprint
				</h1>

				<p class="intro">
					Information about the operator of lunar visuals.
				</p>

			</section>



			<!-- =========================
			     PROVIDER
			     ========================= -->

			<section class="legal-card">

				<span class="section-label">
					01
				</span>

				<h2>
					Provider
				</h2>


				<p class="business-name">
					Lunar Visuals
				</p>


				<p>
					Daria Klokova
				</p>


				<details class="address-details">

					<summary>
						Business address
					</summary>


					<div class="address">

						Kronenstrasse 18B<br />
						79618 Rheinfelden (Baden)<br />
						Province of Baden-Württemberg, Germany

					</div>

				</details>

			</section>



			<!-- =========================
			     CONTACT
			     ========================= -->

			<section class="legal-card">

				<span class="section-label">
					02
				</span>

				<h2>
					Contact
				</h2>


				<p>
					For questions, commission inquiries, legal matters
					or other business-related requests, please contact:
				</p>


				<p>

					<strong>
						Email:
					</strong>

					<a href="mailto:[YOUR EMAIL ADDRESS]">
						[YOUR EMAIL ADDRESS]
					</a>

				</p>


				<!--
				<p>

					<strong>
						Phone:
					</strong>

					+49 156 78307083

				</p>
				-->

			</section>



			<!-- =========================
			     BUSINESS INFORMATION
			     ========================= -->

			<section class="legal-card">

				<span class="section-label">
					03
				</span>

				<h2>
					Business Information
				</h2>


				<p>
					Business activity:
				</p>


				<p class="business-description">
					Trade in merchandise goods, illustration,
					graphic design and related creative services.
				</p>


				<p>

					<strong>
						Business registration:
					</strong>

					Registered with the competent German
					Gewerbeamt.

				</p>

			</section>



			<!-- =========================
			     PROFESSIONAL INFORMATION
			     ========================= -->

			<section class="legal-card">

				<span class="section-label">
					04
				</span>

				<h2>
					Professional Information
				</h2>


				<p>

					<strong>
						Professional designation:
					</strong>

					Staatlich geprüfter Grafikdesigner

				</p>


				<p>

					<strong>
						Country in which the professional
						designation was awarded:
					</strong>

					Germany

				</p>

			</section>



			<!-- =========================
			     TAX INFORMATION
			     ========================= -->

			<section class="legal-card">

				<span class="section-label">
					05
				</span>

				<h2>
					Tax Information
				</h2>


				<p>

					<strong>
						Umsatzsteuer-Identifikationsnummer
						gemäß § 27a UStG:
					</strong>

					DE461412891

				</p>


				<p class="note">
					Umsatzsteuer wird aufgrund der Befreiung für Kleinunternehmer gemäß § 19 UStG nicht ausgewiesen.
				</p>

			</section>



			<!-- =========================
			     REGISTER
			     ========================= -->

			<section class="legal-card">

				<span class="section-label">
					06
				</span>

				<h2>
					Register Information
				</h2>


				<p>
					Lunar Visuals is operated as a business registered
					with the competent Gewerbeamt.
				</p>


				<p>
					There is no entry in the Handelsregister.
				</p>

			</section>



			<!-- =========================
			     RESPONSIBLE PERSON
			     ========================= -->

			<section class="legal-card">

				<span class="section-label">
					07
				</span>

				<h2>
					Responsible Person
				</h2>


				<p>
					Responsible for the content of this website:
				</p>


				<p>

					Kronenstrasse 18B<br />
						79618 Rheinfelden (Baden)<br />
						Province of Baden-Württemberg, Germany

				</p>

			</section>



			<!-- =========================
			     LIABILITY
			     ========================= -->

			<section class="legal-card">

				<span class="section-label">
					08
				</span>

				<h2>
					Liability for Content
				</h2>


				<p>
					I make every effort to ensure that the information
					provided on this website is accurate and up to date.
					However, I cannot guarantee the completeness,
					accuracy or timeliness of all information.
				</p>


				<p>
					As a service provider, I am responsible for my own
					content on this website in accordance with applicable
					law.
				</p>

			</section>



			<!-- =========================
			     EXTERNAL LINKS
			     ========================= -->

			<section class="legal-card">

				<span class="section-label">
					09
				</span>

				<h2>
					Liability for External Links
				</h2>


				<p>
					This website may contain links to external websites
					operated by third parties. I have no control over
					the content of those websites and cannot assume
					responsibility for their content.
				</p>


				<p>
					The respective provider or operator of the linked
					website is responsible for its content.
				</p>

			</section>



			<!-- =========================
			     CONSUMER DISPUTE RESOLUTION
			     ========================= -->

			<section class="legal-card">

				<span class="section-label">
					10
				</span>

				<h2>
					Consumer Dispute Resolution
				</h2>


				<p>
					The European Commission previously provided an
					online dispute resolution platform (ODR platform)
					for consumer disputes. The platform was discontinued
					on 20 July 2025.
				</p>


				<p>
					I am not obliged and, unless legally required,
					do not undertake to participate in dispute
					resolution proceedings before a consumer
					arbitration board.
				</p>

			</section>



			<!-- =========================
			     LAST UPDATED
			     ========================= -->

			<section class="last-updated">

				<p>
					Last updated: 29.08.2026
				</p>

			</section>


		</main>


		<Footer />

	</body>

</html>



<style>

/* =========================
   PAGE
   ========================= */

.legal-page {

	max-width:
		900px;

	margin:
		0 auto;

	padding:
		4rem 1.5rem
		6rem;

}



/* =========================
   HEADING
   ========================= */

.page-heading {

	text-align:
		center;

	margin-bottom:
		3rem;

}


.eyebrow {

	margin:
		0 0 0.7rem;

	color:
		var(--pink-light);

	font-size:
		0.7rem;

	font-weight:
		700;

	letter-spacing:
		0.16em;

}


.page-heading h1 {

	margin:
		0;

	font-size:
		clamp(3rem, 8vw, 5rem);

	line-height:
		1;

	letter-spacing:
		-0.03em;

}


.intro {

	max-width:
		650px;

	margin:
		1rem auto 0;

	color:
		var(--text-muted);

	font-size:
		1rem;

	line-height:
		1.6;

}



/* =========================
   CARDS
   ========================= */

.legal-card {

	margin-bottom:
		1.2rem;

	padding:
		2rem;

	border:
		1px solid
		rgba(255, 130, 225, 0.28);

	border-radius:
		22px;

	background:
		linear-gradient(
			145deg,
			rgba(180, 20, 150, 0.14),
			rgba(40, 10, 50, 0.22)
		);

	box-shadow:
		0 0 18px
		rgba(255, 80, 200, 0.05);

}


.section-label {

	display:
		inline-block;

	margin-bottom:
		0.7rem;

	color:
		var(--pink-light);

	font-size:
		0.7rem;

	font-weight:
		700;

	letter-spacing:
		0.12em;

}


.legal-card h2 {

	margin:
		0 0 1rem;

	font-size:
		1.5rem;

}


.legal-card p {

	margin:
		0 0 1rem;

	color:
		var(--text-muted);

	font-size:
		0.92rem;

	line-height:
		1.65;

}


.legal-card p:last-child {

	margin-bottom:
		0;

}


.business-name {

	color:
		white !important;

	font-size:
		1.1rem !important;

	font-weight:
		700;

}


.business-description {

	color:
		white !important;

}



/* =========================
   ADDRESS
   ========================= */

.address-details {

	margin-top:
		1.2rem;

}


.address-details summary {

	display:
		inline-block;

	cursor:
		pointer;

	color:
		var(--pink-light);

	font-size:
		0.9rem;

	font-weight:
		600;

	list-style:
		none;

}


.address-details summary::-webkit-details-marker {

	display:
		none;

}


.address-details summary::before {

	content:
		"▸";

	display:
		inline-block;

	margin-right:
		0.5rem;

	transition:
		transform 0.2s ease;

}


.address-details[open]
summary::before {

	transform:
		rotate(90deg);

}


.address-details summary:hover {

	color:
		white;

}


.address {

	margin-top:
		1rem;

	padding:
		1rem 1.2rem;

	border:
		1px solid
		rgba(255, 130, 225, 0.2);

	border-radius:
		12px;

	background:
		rgba(255, 255, 255, 0.03);

	color:
		var(--text-muted);

	font-size:
		0.9rem;

	line-height:
		1.7;

}



/* =========================
   LINKS
   ========================= */

.legal-card a {

	color:
		var(--pink-light);

	text-decoration:
		none;

}


.legal-card a:hover {

	color:
		white;

	text-decoration:
		underline;

}



/* =========================
   NOTE
   ========================= */

.note {

	padding-top:
		1rem;

	border-top:
		1px solid
		rgba(255, 255, 255, 0.08);

	font-size:
		0.8rem !important;

}



/* =========================
   LAST UPDATED
   ========================= */

.last-updated {

	padding:
		1.5rem;

	text-align:
		center;

	color:
		var(--text-muted);

	font-size:
		0.75rem;

}



/* =========================
   MOBILE
   ========================= */

@media (max-width: 650px) {

	.legal-page {

		padding:
			2.5rem 0.8rem
			4rem;

	}


	.legal-card {

		padding:
			1.4rem;

		border-radius:
			18px;

	}


	.legal-card h2 {

		font-size:
			1.3rem;

	}


	.legal-card p {

		font-size:
			0.88rem;

	}

}

</style>
