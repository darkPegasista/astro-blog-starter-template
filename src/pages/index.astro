---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GlowCard from '../components/GlowCard.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<main>

	<section class="hero">
		<p class="eyebrow">✦ COMMISSIONS OPEN ✦</p>

		<h1>YOUR ARTIST NAME</h1>

		<p class="intro">
			Illustrations, character art, commissions & merch.
		</p>

		<a class="hero-button" href="/commissions">
			View Commissions
		</a>
	</section>


	<section class="cards">

		<GlowCard
			title="Commissions"
			glow="168 85 247"
			href="/commissions"
		>
			<p>
				Custom artwork, character illustrations and more.
			</p>

			<strong>View prices →</strong>
		</GlowCard>


		<GlowCard
			title="Gallery"
			glow="59 130 246"
			href="/gallery"
		>
			<p>
				Take a look at some of my recent artwork.
			</p>

			<strong>View gallery →</strong>
		</GlowCard>


		<GlowCard
			title="Merch"
			glow="236 72 153"
			href="/shop"
		>
			<p>
				Prints, stickers, clothing and other merch.
			</p>

			<strong>Visit shop →</strong>
		</GlowCard>

	</section>

</main>
		</main>
		<Footer />
	</body>
</html>
