---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>

	<body>

		<Header />

		<main>

			<!-- HERO / ABOUT CARD -->
<section class="main-card">

	<div class="logo-area">

	<img
		src="/Lunar Visuals Logo.svg"
		alt="Lunar Visuals"
		class="main-logo"
	/>

	<p class="artist-name">
		by darkPegasista
	</p>

</div>
				<div class="commission-status">

					<div class="status-title">
						✦ commission status: ✦
					</div>

					<div class="status">
						OPEN
					</div>

				</div>


				<h2>
					✦ Who am I and what can I do? ✦
				</h2>


				<p class="about-text">
					Hi! My name is darkPegasista and I am a passionate
					digital artist. I have been drawing for many years
					and love creating illustrations and character art.
					My work focuses on bringing characters and ideas
					to life through colorful digital artwork.
					<br /><br />
					I also enjoy graphic design, creating websites,
					and exploring new creative projects. In my free
					time I enjoy meeting new people, visiting
					conventions and discovering new ways to express
					my creativity.
				</p>

			</section>


			<!-- SOCIALS -->

			<section class="social-card">

				<h2>✦ Socials ✦</h2>

				<div class="social-links">

					<!-- Opens Instagram -->

					<a
						href="https://www.instagram.com/lunar_dash_visuals/"
						class="social-link"
						target="_blank"
						rel="noopener noreferrer"
					>
						Instagram
					</a>


					<!-- Opens TikTok -->

					<a
						href="https://www.tiktok.com/@lunar_dash_visuals"
						class="social-link"
						target="_blank"
						rel="noopener noreferrer"
					>
						TikTok
					</a>


					<!-- Opens Derpibooru -->

					<a
						href="https://derpibooru.org/profiles/dankPegasista"
						class="social-link"
						target="_blank"
						rel="noopener noreferrer"
					>
						Derpibooru
					</a>


					<!-- Copies Telegram username -->

					<button
						type="button"
						class="social-link copy-social"
						data-username="@darkPegasista"
					>
						Telegram
					</button>


					<!-- Copies Barq username -->

					<button
						type="button"
						class="social-link copy-social"
						data-username="@dash_dP"
					>
						Barq
					</button>

				</div>

			</section>


			<!-- COPY NOTIFICATION -->

			<div
				id="copy-toast"
				class="copy-toast"
				role="status"
				aria-live="polite"
			></div>

		</main>


		<style>

			/* =========================
			   MAIN LAYOUT
			   ========================= */

			main {
				max-width: 900px;
				margin: 0 auto;
				padding: 3rem 1.5rem 5rem;
			}


			/* =========================
			   MAIN ABOUT CARD
			   ========================= */

			.main-card {
				padding: 3rem;

				border-radius: 30px;

				border: 1px solid var(--card-border);

				background:
					linear-gradient(
						145deg,
						rgba(180, 20, 150, 0.22),
						rgba(80, 10, 80, 0.18)
					);

				box-shadow:
					0 0 25px rgba(255, 80, 200, 0.12),
					inset 0 0 30px rgba(255, 80, 200, 0.04);

				backdrop-filter: blur(12px);

				text-align: center;
			}


			/* =========================
			   LOGO PLACEHOLDER
			   ========================= */

			/* =========================
   MAIN LOGO AREA
   ========================= */

.logo-area {

	display: flex;

	flex-direction: column;

	align-items: center;

	justify-content: center;

	width: 100%;

	margin-bottom: 2rem;

}


/* =========================
   MAIN LOGO
   ========================= */

.main-logo {

	width: min(520px, 82%);

	height: auto;

	display: block;
}


/* =========================
   ARTIST NAME
   ========================= */

.artist-name {

	margin:
		0.2rem 0 0;

	font-family:
		var(--font-display);

	font-size:
		clamp(1.5rem, 3vw, 2.2rem);

	font-weight:
		400;

	line-height:
		1;

	color:
		var(--text);

	text-align:
		center;

	letter-spacing:
		0.02em;

	text-shadow:
		0 0 12px rgba(255, 180, 235, 0.25);
}


			/* =========================
			   COMMISSION STATUS
			   ========================= */

			.commission-status {
				max-width: 500px;

				margin: 0 auto 2.5rem;

				padding: 1rem 1.5rem;

				border-radius: 15px;

				border: 1px solid rgba(255, 100, 220, 0.8);

				background: rgba(200, 20, 150, 0.15);

				box-shadow:
					0 0 15px rgba(255, 70, 200, 0.3),
					inset 0 0 15px rgba(255, 70, 200, 0.08);
			}


			.status-title {
				font-size: 0.95rem;
				font-weight: 600;

				letter-spacing: 0.08em;
			}


			.status {
				margin-top: 0.2rem;

				font-size: 2rem;
				font-weight: 700;

				letter-spacing: 0.12em;

				color: white;

				text-shadow:
					0 0 10px rgba(255, 100, 220, 0.8);
			}


			/* =========================
			   ABOUT TEXT
			   ========================= */

			.main-card h2 {
				margin-bottom: 1.5rem;

				font-size: 1.25rem;
			}


			.about-text {
				max-width: 650px;

				margin: 0 auto;

				color: var(--text-muted);

				font-size: 1rem;

				line-height: 1.65;
			}


			/* =========================
			   SOCIALS
			   ========================= */

			.social-card {
				margin-top: 2rem;

				padding: 2.5rem;

				border-radius: 30px;

				border: 1px solid var(--card-border);

				background:
					linear-gradient(
						145deg,
						rgba(180, 20, 150, 0.18),
						rgba(80, 10, 80, 0.14)
					);

				box-shadow:
					0 0 20px rgba(255, 80, 200, 0.08);

				text-align: center;
			}


			.social-card h2 {
				margin-top: 0;
				margin-bottom: 1.5rem;

				font-size: 1.3rem;
			}


			.social-links {
				max-width: 600px;

				margin: 0 auto;

				display: flex;
				flex-direction: column;

				gap: 0.8rem;
			}


			/* =========================
			   SOCIAL BUTTONS
			   ========================= */

			.social-link {
				width: 100%;

				display: flex;
				align-items: center;
				justify-content: center;

				min-height: 44px;

				padding: 0.8rem 1.5rem;

				margin: 0;

				border-radius: 12px;

				border: 1px solid rgba(255, 130, 225, 0.5);

				background: rgba(255, 255, 255, 0.04);

				color: white;

				font-family: inherit;
				font-size: 1rem;
				font-weight: 500;

				line-height: 1.2;

				text-align: center;
				text-decoration: none;

				cursor: pointer;

				box-shadow:
					0 0 8px rgba(255, 80, 200, 0.08);

				transition:
					transform 0.2s ease,
					box-shadow 0.2s ease,
					border-color 0.2s ease,
					background 0.2s ease;

				appearance: none;
				-webkit-appearance: none;
			}


			.social-link:hover {
				transform: translateY(-2px);

				border-color: rgba(255, 130, 225, 0.9);

				background: rgba(255, 70, 200, 0.08);

				box-shadow:
					0 0 15px rgba(255, 80, 200, 0.35),
					0 0 35px rgba(255, 80, 200, 0.12);
			}


			/* =========================
			   COPY TOAST
			   ========================= */

			.copy-toast {
				position: fixed;

				left: 50%;
				bottom: 2rem;

				transform: translate(-50%, 20px);

				padding: 0.8rem 1.4rem;

				border-radius: 999px;

				border: 1px solid
					rgba(255, 130, 225, 0.7);

				background:
					rgba(35, 10, 35, 0.92);

				color: white;

				font-size: 0.9rem;
				font-weight: 600;

				box-shadow:
					0 0 20px
					rgba(255, 80, 200, 0.3);

				backdrop-filter: blur(10px);

				opacity: 0;

				pointer-events: none;

				transition:
					opacity 0.25s ease,
					transform 0.25s ease;

				z-index: 1000;
			}


			.copy-toast.show {
				opacity: 1;

				transform:
					translate(-50%, 0);
			}


			/* =========================
			   MOBILE
			   ========================= */

			@media (max-width: 700px) {

				main {
					padding:
						2rem 0.8rem
						3rem;
				}

				.main-card {
					padding: 2rem 1.2rem;

					border-radius: 22px;
				}

	.logo-area {
		margin-bottom: 1.5rem;
	}

	.main-logo {
		width: 88%;
	}

	.artist-name {
		font-size: 1.5rem;
	}

				.commission-status {
					padding: 0.8rem 1rem;
				}

				.status {
					font-size: 1.6rem;
				}

				.main-card h2 {
					font-size: 1.1rem;
				}

				.about-text {
					font-size: 0.95rem;
				}

				.social-card {
					padding: 2rem 1.2rem;

					border-radius: 22px;
				}

			}

		</style>


		<script>

			const copyButtons =
				document.querySelectorAll('.copy-social');

			const toast =
				document.querySelector('#copy-toast');

			let toastTimeout;


			copyButtons.forEach((button) => {

				button.addEventListener('click', async () => {

					const username =
						button.getAttribute('data-username');

					if (!username || !toast) return;


					try {

						await navigator.clipboard.writeText(username);

						toast.textContent =
							`${username} copied!`;

						toast.classList.add('show');


						clearTimeout(toastTimeout);


						toastTimeout = setTimeout(() => {

							toast.classList.remove('show');

						}, 2500);


					} catch (error) {

						toast.textContent =
							'Could not copy username';

						toast.classList.add('show');


						clearTimeout(toastTimeout);


						toastTimeout = setTimeout(() => {

							toast.classList.remove('show');

						}, 2500);

					}

				});

			});

		</script>


		<Footer />

	</body>
</html>
