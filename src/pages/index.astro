---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GlowCard from '../components/GlowCard.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>

	<!-- HERO / ABOUT CARD -->

	<section class="main-card">

		<div class="logo-placeholder">
			YOUR LOGO
		</div>


		<div class="commission-status">

			<div class="status-title">
				✦ commission status: ✦
			</div>

			<div class="status">
				OPEN
			</div>

		</div>


		<h2>
			✦ Who am I and what can I do? ✦
		</h2>


		<p class="about-text">
			Hi! My name is YOUR NAME and I am a passionate
			digital artist. I have been drawing for many years
			and love creating illustrations and character art.
			My work focuses on bringing characters and ideas
			to life through colorful digital artwork.
			<br /><br />
			I also enjoy graphic design, creating websites,
			and exploring new creative projects. In my free
			time I enjoy meeting new people, visiting
			conventions and discovering new ways to express
			my creativity.
		</p>

	</section>


	<!-- SOCIALS -->

	<section class="social-card">

		<h2>✦ Socials ✦</h2>

		<div class="social-links">

			<a href="#" class="social-link">
				Instagram
			</a>

			<a href="#" class="social-link">
				TikTok
			</a>

			<a href="#" class="social-link">
				Derpibooru
			</a>

			<a href="#" class="social-link">
				barq
			</a>

		</div>

	</section>

</main>
<style>

	main {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2rem;
	}

	.hero {
		min-height: 60vh;

		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;

		text-align: center;
	}

	.hero h1 {
		margin: 0;

		font-size: clamp(3rem, 8vw, 6rem);
		line-height: 1;
	}

	.eyebrow {
		color: rgb(192, 132, 252);

		font-size: 0.9rem;
		font-weight: 700;
		letter-spacing: 0.15em;

		margin-bottom: 1.5rem;
	}

	.intro {
		max-width: 600px;

		font-size: 1.25rem;
		opacity: 0.75;

		margin: 1.5rem 0 2rem;
	}

	.hero-button {
		display: inline-block;

		padding: 0.9rem 1.6rem;

		border-radius: 999px;
		border: 1px solid rgba(168, 85, 247, 0.6);

		background: rgba(168, 85, 247, 0.12);
		color: white;

		text-decoration: none;
		font-weight: 700;

		box-shadow:
			0 0 20px rgba(168, 85, 247, 0.15);

		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease,
			background 0.2s ease;
	}

	.hero-button:hover {
		transform: translateY(-2px);

		background: rgba(168, 85, 247, 0.2);

		box-shadow:
			0 0 30px rgba(168, 85, 247, 0.3);
	}

	.cards {
		display: grid;
		grid-template-columns: repeat(3, 1fr);

		gap: 1.5rem;

		margin: 0 auto 6rem;
	}
	@media (max-width: 800px) {

		.cards {
			grid-template-columns: 1fr;
		}
	}
</style>
		<Footer />
	</body>
</html>
