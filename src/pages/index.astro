---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>

	<body>

		<Header />

		<main>

			<!-- =====================================================
			     HERO / ABOUT
			     ===================================================== -->

			<section class="main-card">

				<!-- Logo -->

				<div class="logo-area">

					<img
						src="/Lunar Visuals Logo.svg"
						alt="Lunar Visuals"
						class="main-logo"
					/>

				</div>


				<!-- Commission Status -->

				<div class="commission-status">

					<div class="status-title">
						✦ commission status: ✦
					</div>

					<div class="status">
						OPEN
					</div>

				</div>


				<!-- About -->

				<h2 class="display-title">
					✦ Who am I and what can I do? ✦
				</h2>

				<div class="about-text">

					<p>
						Hi, I’m darkPegasista! I’m a passionate digital artist
						and a long-time member of the brony community, drawing
						ponies for over a decade. My passion for visual arts led
						me to become a state-certified graphic designer in Germany.
					</p>

					<p>
						At conventions, you’ll often find me connecting with
						fellow creatives or diving into new artistic hobbies.
						Exchanging ideas with talented people is what inspires
						my work every day.
					</p>

					<p>
						This site is my central hub where you can request
						commissions, check out updates on upcoming events,
						browse my merchandise, or just connect with me!
					</p>

				</div>

			</section>


			<!-- =====================================================
			     SOCIALS
			     ===================================================== -->

			<section class="social-card">

				<h2 class="display-title">
					✦ Socials ✦
				</h2>

				<div class="social-links">

					<a
						href="https://www.instagram.com/lunar_dash_visuals/"
						class="social-link"
						target="_blank"
						rel="noopener noreferrer"
					>
						Instagram
					</a>

					<a
						href="https://www.tiktok.com/@lunar_dash_visuals"
						class="social-link"
						target="_blank"
						rel="noopener noreferrer"
					>
						TikTok
					</a>

					<a
						href="https://derpibooru.org/profiles/dankPegasista"
						class="social-link"
						target="_blank"
						rel="noopener noreferrer"
					>
						Derpibooru
					</a>

					<button
						type="button"
						class="social-link copy-social"
						data-username="@darkPegasista"
					>
						Telegram
					</button>

					<button
						type="button"
						class="social-link copy-social"
						data-username="@dash_dP"
					>
						Barq
					</button>

				</div>

			</section>


			<!-- Copy notification -->

			<div
				id="copy-toast"
				class="copy-toast"
				role="status"
				aria-live="polite"
			></div>

		</main>


		<!-- =========================================================
		     PAGE STYLES
		     ========================================================= -->

		<style>

			/* =====================================================
			   MAIN LAYOUT
			   ===================================================== */

			main {
				max-width: 900px;
				margin: 0 auto;
				padding: 3rem 1.5rem 5rem;
			}


			/* =====================================================
			   MAIN ABOUT CARD
			   ===================================================== */

			.main-card {
				padding: 3rem;

				border-radius: 30px;

				border: 1px solid var(--card-border);

				background:
					linear-gradient(
						145deg,
						rgba(180, 20, 150, 0.22),
						rgba(80, 10, 80, 0.18)
					);

				box-shadow:
					0 0 25px rgba(255, 80, 200, 0.12),
					inset 0 0 30px rgba(255, 80, 200, 0.04);

				backdrop-filter: blur(12px);

				text-align: center;
			}


			/* =====================================================
			   LOGO
			   ===================================================== */

			.logo-area {
				display: flex;
				align-items: center;
				justify-content: center;

				width: 100%;

				/*
				 * Extra breathing room between the logo and
				 * the commission status card.
				 */
				margin-bottom: 3.5rem;
			}

			.main-logo {
				display: block;

				width: min(520px, 82%);
				height: auto;
			}


			/* =====================================================
			   COMMISSION STATUS
			   ===================================================== */

			.commission-status {
				max-width: 500px;

				margin: 0 auto 2.8rem;

				padding: 1rem 1.5rem;

				border-radius: 15px;

				border: 1px solid rgba(255, 100, 220, 0.8);

				background: rgba(200, 20, 150, 0.15);

				box-shadow:
					0 0 15px rgba(255, 70, 200, 0.3),
					inset 0 0 15px rgba(255, 70, 200, 0.08);
			}

			.status-title {
				font-size: 0.95rem;
				font-weight: 600;

				letter-spacing: 0.08em;
			}

			.status {
				margin-top: 0.2rem;

				font-size: 2rem;
				font-weight: 700;

				letter-spacing: 0.12em;

				color: white;

				text-shadow:
					0 0 10px rgba(255, 100, 220, 0.8);
			}


			/* =====================================================
			   ABOUT SECTION
			   ===================================================== */

			.main-card h2 {
				margin-top: 0;
				margin-bottom: 1.7rem;

				font-size: 1.5rem;
			}

			.about-text {
				max-width: 820px;

				margin: 0 auto;

				color: var(--text-muted);

				font-size: 1rem;

				line-height: 1.65;
			}

			.about-text p {
				max-width: 820px;

				margin: 0 auto 1.4rem;
			}

			.about-text p:first-child {
				color: var(--text);
			}

			.about-text p:last-child {
				margin-bottom: 0;
			}


			/* =====================================================
			   SOCIAL CARD
			   ===================================================== */

			.social-card {
				margin-top: 2rem;

				padding: 2.5rem;

				border-radius: 30px;

				border: 1px solid var(--card-border);

				background:
					linear-gradient(
						145deg,
						rgba(180, 20, 150, 0.18),
						rgba(80, 10, 80, 0.14)
					);

				box-shadow:
					0 0 20px rgba(255, 80, 200, 0.08);

				text-align: center;
			}

			.social-card h2 {
				margin-top: 0;
				margin-bottom: 1.5rem;

				font-size: 1.3rem;
			}


			/* =====================================================
			   SOCIAL LINKS
			   ===================================================== */

			.social-links {
				max-width: 600px;

				margin: 0 auto;

				display: flex;
				flex-direction: column;

				gap: 0.8rem;
			}

			.social-link {
				width: 100%;

				display: flex;
				align-items: center;
				justify-content: center;

				min-height: 44px;

				padding: 0.8rem 1.5rem;
				margin: 0;

				border-radius: 12px;

				border: 1px solid rgba(255, 130, 225, 0.5);

				background: rgba(255, 255, 255, 0.04);

				color: white;

				font-family: inherit;
				font-size: 1rem;
				font-weight: 500;

				line-height: 1.2;

				text-align: center;
				text-decoration: none;

				cursor: pointer;

				box-shadow:
					0 0 8px rgba(255, 80, 200, 0.08);

				transition:
					transform 0.2s ease,
					box-shadow 0.2s ease,
					border-color 0.2s ease,
					background 0.2s ease;

				appearance: none;
				-webkit-appearance: none;
			}

			.social-link:hover {
				transform: translateY(-2px);

				border-color: rgba(255, 130, 225, 0.9);

				background: rgba(255, 70, 200, 0.08);

				box-shadow:
					0 0 15px rgba(255, 80, 200, 0.35),
					0 0 35px rgba(255, 80, 200, 0.12);
			}


			/* =====================================================
			   COPY TOAST
			   ===================================================== */

			.copy-toast {
				position: fixed;

				left: 50%;
				bottom: 2rem;

				transform: translate(-50%, 20px);

				padding: 0.8rem 1.4rem;

				border-radius: 999px;

				border: 1px solid rgba(255, 130, 225, 0.7);

				background: rgba(35, 10, 35, 0.92);

				color: white;

				font-size: 0.9rem;
				font-weight: 600;

				box-shadow:
					0 0 20px rgba(255, 80, 200, 0.3);

				backdrop-filter: blur(10px);

				opacity: 0;

				pointer-events: none;

				transition:
					opacity 0.25s ease,
					transform 0.25s ease;

				z-index: 1000;
			}

			.copy-toast.show {
				opacity: 1;

				transform: translate(-50%, 0);
			}


			/* =====================================================
			   MOBILE
			   ===================================================== */

			@media (max-width: 700px) {

				main {
					padding: 2rem 0.8rem 3rem;
				}

				.main-card {
					padding: 2rem 1.2rem;

					border-radius: 22px;
				}

				.logo-area {
					margin-bottom: 2.5rem;
				}

				.main-logo {
					width: 88%;
				}

				.commission-status {
					padding: 0.8rem 1rem;

					margin-bottom: 2.3rem;
				}

				.status {
					font-size: 1.6rem;
				}

				.main-card h2 {
					font-size: 1.2rem;
				}

				.about-text {
					font-size: 0.95rem;
				}

				.about-text p {
					margin-bottom: 1.2rem;
				}

				.social-card {
					padding: 2rem 1.2rem;

					border-radius: 22px;
				}
			}

		</style>


		<!-- =========================================================
		     COPY SOCIAL USERNAMES
		     ========================================================= -->

		<script>

			const copyButtons =
				document.querySelectorAll('.copy-social');

			const toast =
				document.querySelector('#copy-toast');

			let toastTimeout;


			copyButtons.forEach((button) => {

				button.addEventListener('click', async () => {

					const username =
						button.getAttribute('data-username');

					if (!username || !toast) return;


					try {

						await navigator.clipboard.writeText(username);

						toast.textContent =
							`${username} copied!`;

						toast.classList.add('show');

						clearTimeout(toastTimeout);

						toastTimeout = setTimeout(() => {
							toast.classList.remove('show');
						}, 2500);

					} catch (error) {

						toast.textContent =
							'Could not copy username';

						toast.classList.add('show');

						clearTimeout(toastTimeout);

						toastTimeout = setTimeout(() => {
							toast.classList.remove('show');
						}, 2500);

					}

				});

			});

		</script>


		<Footer />

	</body>
</html>
