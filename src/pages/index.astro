---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GlowCard from '../components/GlowCard.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<main>

	<section class="hero">
		<p class="eyebrow">✦ COMMISSIONS OPEN ✦</p>

		<h1>YOUR ARTIST NAME</h1>

		<p class="intro">
			Illustrations, character art, commissions & merch.
		</p>

		<a class="hero-button" href="/commissions">
			View Commissions
		</a>
	</section>


	<section class="cards">

		<GlowCard
			title="Commissions"
			glow="168 85 247"
			href="/commissions"
		>
			<p>
				Custom artwork, character illustrations and more.
			</p>

			<strong>View prices →</strong>
		</GlowCard>


		<GlowCard
			title="Gallery"
			glow="59 130 246"
			href="/gallery"
		>
			<p>
				Take a look at some of my recent artwork.
			</p>

			<strong>View gallery →</strong>
		</GlowCard>


		<GlowCard
			title="Merch"
			glow="236 72 153"
			href="/shop"
		>
			<p>
				Prints, stickers, clothing and other merch.
			</p>

			<strong>Visit shop →</strong>
		</GlowCard>

	</section>

</main>
		</main>
<style>

	main {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2rem;
	}

	.hero {
		min-height: 60vh;

		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;

		text-align: center;
	}

	.hero h1 {
		margin: 0;

		font-size: clamp(3rem, 8vw, 6rem);
		line-height: 1;
	}

	.eyebrow {
		color: rgb(192, 132, 252);

		font-size: 0.9rem;
		font-weight: 700;
		letter-spacing: 0.15em;

		margin-bottom: 1.5rem;
	}

	.intro {
		max-width: 600px;

		font-size: 1.25rem;
		opacity: 0.75;

		margin: 1.5rem 0 2rem;
	}

	.hero-button {
		display: inline-block;

		padding: 0.9rem 1.6rem;

		border-radius: 999px;
		border: 1px solid rgba(168, 85, 247, 0.6);

		background: rgba(168, 85, 247, 0.12);
		color: white;

		text-decoration: none;
		font-weight: 700;

		box-shadow:
			0 0 20px rgba(168, 85, 247, 0.15);

		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease,
			background 0.2s ease;
	}

	.hero-button:hover {
		transform: translateY(-2px);

		background: rgba(168, 85, 247, 0.2);

		box-shadow:
			0 0 30px rgba(168, 85, 247, 0.3);
	}

	.cards {
		display: grid;
		grid-template-columns: repeat(3, 1fr);

		gap: 1.5rem;

		margin: 0 auto 6rem;
	}
	@media (max-width: 800px) {

		.cards {
			grid-template-columns: 1fr;
		}
	}
</style>
		<Footer />
	</body>
</html>
