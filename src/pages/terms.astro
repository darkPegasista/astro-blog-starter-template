---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>

<html lang="en">

	<head>

		<BaseHead
			title="Terms"
			description="Commission terms, artwork usage and other important information."
		/>

	</head>


	<body>

		<Header />


		<main class="terms-page">


			<!-- =========================
			     PAGE HEADING
			     ========================= -->

			<section class="page-heading">

				<p class="eyebrow">
					✦ PLEASE READ ✦
				</p>

				<h1>
					Terms
				</h1>

				<p class="intro">
					These terms are here so we're both on the same page
					when working together. If you're unsure about anything,
					feel free to ask!
				</p>

			</section>



			<!-- =========================
			     BEFORE YOU COMMISSION
			     ========================= -->

			<section class="terms-card highlight">

				<h2>
					Before You Commission Me
				</h2>

				<p>
					Please read these terms before commissioning me.
					They explain how my commission process works,
					how artwork may be used, and what you can expect
					from me.
				</p>

				<p>
					If something isn't covered here, just ask!
					I'm happy to discuss unusual requests and
					custom projects.
				</p>

			</section>



			<!-- =========================
			     01 WHAT I DRAW
			     ========================= -->

			<section class="terms-card">

				<span class="section-number">
					01
				</span>

				<h2>
					What I Draw
				</h2>


				<h3>
					Will Draw
				</h3>

				<p>
					Furry, human/humanoid characters, ponies,
					fanart, NSFW and horror, including MLP AUs.
				</p>


				<h3>
					Custom Character Designs
				</h3>

				<p>
					I also accept custom character design commissions.
					For these, please provide a visual reference or
					a sufficiently detailed description of what you
					would like.
				</p>


				<h3>
					Complex Designs
				</h3>

				<p>
					Particularly complicated characters, props or
					backgrounds may require an additional fee depending
					on the amount of work involved.
				</p>


				<h3>
					Won't Draw
				</h3>

				<p>
					Hardcore fetishes or pedophilic artwork of any kind.
				</p>

			</section>



			<!-- =========================
			     02 CONSULTATION
			     ========================= -->

			<section class="terms-card">

				<span class="section-number">
					02
				</span>

				<h2>
					Consultation
				</h2>

				<p>
					All commissions begin with a thorough consultation.
					You can tell me what you would like, provide
					references, and explain any important details
					about the character, pose, composition, background
					or other aspects of the artwork.
				</p>

				<p>
					Before I begin the commission, I will summarize
					the agreed concept back to you. This gives both
					of us the opportunity to make sure that we have
					the same understanding of what is being commissioned.
				</p>

				<p>
					The final price and scope of the commission are
					agreed upon after this consultation.
				</p>

			</section>



			<!-- =========================
			     03 PAYMENT
			     ========================= -->

			<section class="terms-card">

				<span class="section-number">
					03
				</span>

				<h2>
					Payment
				</h2>

				<p>
					Full payment is required before I begin working
					on a commission.
				</p>

				<p>
					After the commission details and price have been
					agreed upon, I will issue an invoice.
				</p>

				<p>
					Payment is normally made by bank transfer using
					the payment information provided on the invoice.
					PayPal may be available by arrangement.
				</p>

				<p>
					Commission payments are handled separately from
					the merchandise shop and are not processed through
					the shop's shopping cart.
				</p>

			</section>



			<!-- =========================
			     04 COMMISSION PROCESS
			     ========================= -->

			<section class="terms-card">

				<span class="section-number">
					04
				</span>

				<h2>
					Commission Process
				</h2>

				<p>
					After payment has been received, I will create
					three initial sketches based on our consultation.
					These sketches represent different concepts,
					poses or compositions for the commission.
				</p>

				<p>
					You choose one of these three concepts to continue
					with.
				</p>

				<p>
					The chosen sketch can then be modified with
					reasonable changes before I move on to the
					lineart.
				</p>

				<p>
					If none of the three initial concepts works for
					you, I will create one additional sketch based
					on further discussion.
				</p>

				<p>
					Once the sketch has been settled, I will proceed
					with the lineart and then the finished artwork.
				</p>

			</section>



			<!-- =========================
			     05 REVISIONS
			     ========================= -->

			<section class="terms-card">

				<span class="section-number">
					05
				</span>

				<h2>
					Revisions
				</h2>

				<p>
					Reasonable changes are welcome during the sketching
					phase. This is the time to make sure that the pose,
					composition and general idea are right before I
					continue with the detailed artwork.
				</p>

				<p>
					Once the lineart has been started, changes that
					require significant additional work may incur
					an additional fee.
				</p>

				<p>
					Corrections resulting from a mistake on my part
					will of course be made without an additional charge.
				</p>

			</section>



			<!-- =========================
			     06 TURNAROUND
			     ========================= -->

			<section class="terms-card">

				<span class="section-number">
					06
				</span>

				<h2>
					Turnaround Time
				</h2>

				<p>
					Most commissions take anywhere from a few days
					to approximately four weeks to complete.
				</p>

				<p>
					The actual turnaround depends on the complexity
					of the commission and my current workload.
				</p>

				<p>
					I will keep you informed about the progress of
					your commission throughout the process and will
					let you know if there is a significant delay.
				</p>

			</section>



			<!-- =========================
			     07 CUSTOMER COMMUNICATION
			     ========================= -->

			<section class="terms-card">

				<span class="section-number">
					07
				</span>

				<h2>
					Communication
				</h2>

				<p>
					Good communication is important to the commission
					process. I will provide regular updates so you
					know how your commission is progressing.
				</p>

				<p>
					If I do not receive a response from you for an
					extended period, I will wait up to 30 days before
					putting the commission on hold.
				</p>

				<p>
					A commission placed on hold can be resumed once
					communication is re-established.
				</p>

			</section>



			<!-- =========================
			     08 CANCELLATION
			     ========================= -->

			<section class="terms-card">

				<span class="section-number">
					08
				</span>

				<h2>
					Cancellations & Refunds
				</h2>

				<p>
					If you need to cancel a commission, please contact
					me as soon as possible.
				</p>

				<p>
					If I have to cancel a commission because I am
					unable to complete it, you will receive a full
					refund of the amount paid.
				</p>

				<p>
					Customer cancellations and any applicable refunds
					are subject to the applicable consumer protection
					laws.
				</p>

				<p class="note">
					Nothing in these terms is intended to limit any
					statutory consumer rights that cannot legally be
					excluded.
				</p>

			</section>



			<!-- =========================
			     09 DIGITAL DELIVERY
			     ========================= -->

			<section class="terms-card">

				<span class="section-number">
					09
				</span>

				<h2>
					Digital Delivery
				</h2>

				<p>
					Digital illustration commissions are delivered
					electronically after completion.
				</p>

				<p>
					Depending on the commission and the customer's
					needs, I can provide finished artwork in
					JPEG, PNG, TIFF and PDF formats.
				</p>

				<p>
					Working files and source files are not included.
					This includes layered project files and other
					files used internally to create the artwork.
				</p>

				<p>
					The customer is responsible for providing a valid
					email address or other agreed method of delivery.
				</p>

			</section>



			<!-- =========================
			     10 PHYSICAL COMMISSIONS
			     ========================= -->

			<section class="terms-card">

				<span class="section-number">
					10
				</span>

				<h2>
					Physical & Traditional Commissions
				</h2>

				<p>
					I may also offer physical commissions such as
					traditional artwork, laminated badges, holographic
					finishes or other custom-made items.
				</p>

				<p>
					The materials, dimensions, finish and other
					details of a physical commission will be agreed
					upon before production begins.
				</p>

				<p>
					Because these items may be individually made
					according to the customer's specifications,
					different legal rules may apply to them than
					to standard merchandise.
				</p>

			</section>



			<!-- =========================
			     11 COPYRIGHT
			     ========================= -->

			<section class="terms-card">

				<span class="section-number">
					11
				</span>

				<h2>
					Copyright & Artwork Usage
				</h2>

				<p>
					Unless otherwise agreed in writing, I retain the
					copyright to artwork that I create.
				</p>

				<p>
					Commissioning artwork does not transfer the
					copyright to the customer.
				</p>

				<p>
					The customer receives permission to use the
					finished commissioned artwork for personal,
					non-commercial purposes.
				</p>


				<div class="usage-grid">

					<div>

						<h3>
							Personal Use
						</h3>

						<ul>

							<li>
								Profile pictures
							</li>

							<li>
								Social media
							</li>

							<li>
								Personal websites
							</li>

							<li>
								Personal wallpapers
							</li>

							<li>
								Personal prints
							</li>

						</ul>

					</div>


					<div>

						<h3>
							Commercial Use
						</h3>

						<ul>

							<li>
								Merchandise for sale
							</li>

							<li>
								Commercial advertising
							</li>

							<li>
								Business branding
							</li>

							<li>
								Products for sale
							</li>

							<li>
								Other commercial exploitation
							</li>

						</ul>

					</div>

				</div>


				<p>
					Commercial use requires a separate agreement.
					Please contact me if you would like to use
					commissioned artwork commercially.
				</p>

			</section>



			<!-- =========================
			     12 CHARACTER OWNERSHIP
			     ========================= -->

			<section class="terms-card">

				<span class="section-number">
					12
				</span>

				<h2>
					Characters & Intellectual Property
				</h2>

				<p>
					Characters, names, logos and other intellectual
					property supplied by the customer remain the
					property of their respective owners.
				</p>

				<p>
					Commissioning artwork does not transfer ownership
					of the underlying character or intellectual property
					to me.
				</p>

				<p>
					Likewise, purchasing a commission does not transfer
					the copyright in my artwork to the customer.
				</p>

			</section>



			<!-- =========================
			     13 PORTFOLIO
			     ========================= -->

			<section class="terms-card">

				<span class="section-number">
					13
				</span>

				<h2>
					Portfolio & Posting
				</h2>

				<p>
					I may display completed commissions on my website,
					in my portfolio, at conventions and on social media
					to showcase my work.
				</p>

				<p>
					If you would like your commission to remain private,
					please let me know before or during the commission
					process.
				</p>

			</section>



			<!-- =========================
			     14 AI
			     ========================= -->

			<section class="terms-card ai-card">

				<span class="section-number">
					14
				</span>

				<h2>
					AI & Machine Learning
				</h2>

				<p>
					I do not use generative AI to create commissioned
					artwork or other artwork offered through this website.
				</p>

				<p>
					My artwork may not be submitted to, uploaded to,
					or otherwise used for training, fine-tuning, testing
					or development of generative AI or machine-learning
					models without my explicit written permission.
				</p>

				<p>
					This includes automated scraping, datasets and
					other services whose purpose includes collecting
					artwork for AI or machine-learning development.
				</p>

				<p class="strong">
					Please do not use my artwork to train or improve
					AI image-generation systems.
				</p>

			</section>



			<!-- =========================
			     15 CUSTOMER RESPONSIBILITIES
			     ========================= -->

			<section class="terms-card">

				<span class="section-number">
					15
				</span>

				<h2>
					Customer Responsibilities
				</h2>

				<p>
					You are responsible for providing accurate
					references, descriptions and other information
					needed to complete your commission.
				</p>

				<p>
					Please make sure that you have the necessary rights
					to any reference material, characters or other
					intellectual property that you ask me to use.
				</p>

				<p>
					I am not responsible for delays caused by missing
					information, unavailable references or delayed
					customer responses.
				</p>

			</section>



			<!-- =========================
			     16 FINAL
			     ========================= -->

			<section class="terms-card">

				<span class="section-number">
					16
				</span>

				<h2>
					A Few Final Things
				</h2>

				<p>
					I reserve the right to refuse a commission request.
				</p>

				<p>
					These terms may be updated from time to time.
					The terms applicable to an existing commission
					will generally be those agreed upon when the
					commission was accepted.
				</p>

				<p>
					If you have a request that isn't covered here,
					please ask! I'm always happy to discuss custom
					projects and unusual ideas.
				</p>

				<p class="friendly">
					Thanks for reading, and have fun! :3
				</p>

			</section>



			<!-- =========================
			     LEGAL LINKS
			     ========================= -->

			<section class="legal-links">

				<p>
					Looking for the formal legal information?
				</p>

				<div>

					<a href="/imprint">
						Imprint
					</a>

					<a href="/privacy">
						Privacy Policy
					</a>

					<a href="/withdrawal">
						Withdrawal Information
					</a>

				</div>

			</section>


		</main>


		<Footer />

	</body>

</html>



<style>

/* =========================
   PAGE
   ========================= */

.terms-page {

	max-width:
		900px;

	margin:
		0 auto;

	padding:
		4rem 1.5rem
		6rem;

}



/* =========================
   HEADING
   ========================= */

.page-heading {

	text-align:
		center;

	margin-bottom:
		3rem;

}


.eyebrow {

	margin:
		0 0 0.7rem;

	color:
		var(--pink-light);

	font-size:
		0.7rem;

	font-weight:
		700;

	letter-spacing:
		0.16em;

}


.page-heading h1 {

	margin:
		0;

	font-size:
		clamp(3rem, 8vw, 5rem);

	line-height:
		1;

	letter-spacing:
		-0.03em;

}


.intro {

	max-width:
		650px;

	margin:
		1rem auto 0;

	color:
		var(--text-muted);

	font-size:
		1rem;

	line-height:
		1.6;

}



/* =========================
   CARDS
   ========================= */

.terms-card {

	position:
		relative;

	margin-bottom:
		1.2rem;

	padding:
		2rem;

	border:
		1px solid
		rgba(255, 130, 225, 0.28);

	border-radius:
		22px;

	background:
		linear-gradient(
			145deg,
			rgba(180, 20, 150, 0.14),
			rgba(40, 10, 50, 0.22)
		);

	box-shadow:
		0 0 18px
		rgba(255, 80, 200, 0.05);

}


.terms-card.highlight {

	border-color:
		rgba(255, 130, 225, 0.55);

	box-shadow:
		0 0 25px
		rgba(255, 80, 200, 0.12);

}



/* =========================
   SECTION NUMBER
   ========================= */

.section-number {

	display:
		inline-block;

	margin-bottom:
		0.7rem;

	color:
		var(--pink-light);

	font-size:
		0.7rem;

	font-weight:
		700;

	letter-spacing:
		0.12em;

}



/* =========================
   HEADINGS
   ========================= */

.terms-card h2 {

	margin:
		0 0 1rem;

	font-size:
		1.5rem;

	line-height:
		1.2;

}


.terms-card h3 {

	margin:
		1.5rem 0 0.5rem;

	font-size:
		0.95rem;

	color:
		rgba(255, 255, 255, 0.9);

}


.terms-card h3:first-of-type {

	margin-top:
		1rem;

}



/* =========================
   TEXT
   ========================= */

.terms-card p {

	margin:
		0 0 1rem;

	color:
		var(--text-muted);

	font-size:
		0.92rem;

	line-height:
		1.65;

}


.terms-card p:last-child {

	margin-bottom:
		0;

}


.terms-card .strong {

	color:
		white;

	font-weight:
		600;

}


.note {

	margin-top:
		1.5rem !important;

	padding-top:
		1rem;

	border-top:
		1px solid
		rgba(255, 255, 255, 0.08);

	font-size:
		0.8rem !important;

}



/* =========================
   USAGE GRID
   ========================= */

.usage-grid {

	display:
		grid;

	grid-template-columns:
		repeat(2, 1fr);

	gap:
		1rem;

	margin:
		1.5rem 0;

}


.usage-grid > div {

	padding:
		1.2rem;

	border:
		1px solid
		rgba(255, 130, 225, 0.18);

	border-radius:
		14px;

	background:
		rgba(0, 0, 0, 0.12);

}


.usage-grid h3 {

	margin:
		0 0 0.7rem;

	color:
		var(--pink-light);

	font-size:
		0.9rem;

}


.usage-grid ul {

	margin:
		0;

	padding-left:
		1.2rem;

	color:
		var(--text-muted);

	font-size:
		0.82rem;

	line-height:
		1.8;

}



/* =========================
   AI SECTION
   ========================= */

.ai-card {

	border-color:
		rgba(180, 100, 255, 0.35);

}


.ai-card .section-number {

	color:
		#d99aff;

}



/* =========================
   FRIENDLY ENDING
   ========================= */

.friendly {

	margin-top:
		1.5rem !important;

	color:
		var(--pink-light) !important;

	font-size:
		1rem !important;

	font-weight:
		600;

}



/* =========================
   LEGAL LINKS
   ========================= */

.legal-links {

	padding:
		2rem 1rem;

	text-align:
		center;

	color:
		var(--text-muted);

}


.legal-links p {

	margin:
		0 0 1rem;

	font-size:
		0.8rem;

}


.legal-links div {

	display:
		flex;

	justify-content:
		center;

	flex-wrap:
		wrap;

	gap:
		1.5rem;

}


.legal-links a {

	color:
		var(--pink-light);

	font-size:
		0.85rem;

	text-decoration:
		none;

}


.legal-links a:hover {

	text-decoration:
		underline;

}



/* =========================
   MOBILE
   ========================= */

@media (max-width: 650px) {

	.terms-page {

		padding:
			2.5rem 0.8rem
			4rem;

	}


	.terms-card {

		padding:
			1.4rem;

		border-radius:
			18px;

	}


	.terms-card h2 {

		font-size:
			1.3rem;

	}


	.terms-card p {

		font-size:
			0.88rem;

	}


	.usage-grid {

		grid-template-columns:
			1fr;

		gap:
			0.8rem;

	}

}

</style>
