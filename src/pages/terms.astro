---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>

<html lang="en">

	<head>

		<BaseHead
			title="Terms"
			description="Commission terms, artwork usage and other important information."
		/>

	</head>


	<body>

		<Header />


		<main class="terms-page">


			<!-- =========================
			     PAGE HEADING
			     ========================= -->

			<section class="page-heading">

				<p class="eyebrow">
					✦ PLEASE READ ✦
				</p>

				<h1>
					Terms
				</h1>

				<p class="intro">
					These terms are here so we're both on the same page
					when working together. If you're unsure about anything,
					feel free to ask!
				</p>

			</section>



			<!-- =========================
			     QUICK INFO
			     ========================= -->

			<section class="terms-card highlight">

				<h2>
					Before You Commission Me
				</h2>

				<p>
					Please make sure you've read these terms before
					commissioning me. By commissioning me, you agree
					to the terms below.
				</p>

				<p>
					If something isn't covered here, just ask!
					I'm happy to discuss unusual requests and
					custom projects.
				</p>

			</section>



			<!-- =========================
			     1. WHAT I DRAW
			     ========================= -->

			<section class="terms-card">

				<span class="section-number">
					01
				</span>

				<h2>
					What I Draw
				</h2>


				<h3>
					Will Draw
				</h3>

				<p>
					Furry, human/humanoid characters, ponies,
					fanart, NSFW and horror (including MLP AUs).
				</p>

				<h3>
					Custom Character Designs
				</h3>

				<p>
					I also do custom character design commissions.
					For these, I will need a visual reference or
					a sufficiently detailed description of the
					character.
				</p>

				<h3>
					Complex Designs
				</h3>

				<p>
					If your character has a particularly complicated
					design, I may need to charge extra depending on
					the amount of additional work required.
				</p>

				<p>
					The same applies to very detailed or elaborate
					backgrounds.
				</p>


				<h3>
					Won't Draw
				</h3>

				<p>
					Hardcore fetishes or pedophilic artwork of any kind.
				</p>

			</section>



			<!-- =========================
			     2. PAYMENT
			     ========================= -->

			<section class="terms-card">

				<span class="section-number">
					02
				</span>

				<h2>
					Payment
				</h2>

				<p>
					Commission prices are agreed upon before I begin
					the commission.
				</p>

				<p>
					Payment is made through PayPal and is required
					before I begin working on the commission.
				</p>

				<p>
					Additional charges may apply if the scope of the
					commission changes after the original price was
					agreed upon.
				</p>

			</section>



			<!-- =========================
			     3. COMMISSION PROCESS
			     ========================= -->

			<section class="terms-card">

				<span class="section-number">
					03
				</span>

				<h2>
					Commission Process
				</h2>

				<p>
					Once the commission has been agreed upon and paid,
					I will begin working on it.
				</p>

				<p>
					Depending on the type of commission, I may provide
					a sketch or work-in-progress for approval before
					completing the artwork.
				</p>

				<p>
					Please provide clear references and instructions
					at the beginning of the commission. The better I
					understand what you want, the better I can make
					the finished piece.
				</p>

			</section>



			<!-- =========================
			     4. REVISIONS
			     ========================= -->

			<section class="terms-card">

				<span class="section-number">
					04
				</span>

				<h2>
					Revisions
				</h2>

				<p>
					Reasonable corrections and changes can be made
					during the sketch or approval stage.
				</p>

				<p>
					Once a stage has been approved and I have moved
					on to more detailed work, major changes may require
					an additional fee.
				</p>

				<p>
					Changes resulting from a mistake on my part will
					of course be corrected without an additional charge.
				</p>

			</section>



			<!-- =========================
			     5. TURNAROUND
			     ========================= -->

			<section class="terms-card">

				<span class="section-number">
					05
				</span>

				<h2>
					Turnaround Time
				</h2>

				<p>
					Turnaround times are estimates and depend on the
					complexity of the commission and my current workload.
				</p>

				<p>
					If a commission is going to take significantly
					longer than expected, I will let you know.
				</p>

				<p>
					Please understand that commissions are handmade
					artwork and may take some time to complete.
				</p>

			</section>



			<!-- =========================
			     6. REFUNDS
			     ========================= -->

			<section class="terms-card">

				<span class="section-number">
					06
				</span>

				<h2>
					Cancellations & Refunds
				</h2>

				<p>
					If you need to cancel a commission, please contact
					me as soon as possible.
				</p>

				<p>
					Whether a refund is possible may depend on the
					current stage of the commission and the applicable
					consumer protection laws.
				</p>

				<p>
					I will always try to find a fair solution if a
					commission needs to be cancelled.
				</p>

				<p class="note">
					Nothing in these terms is intended to limit any
					statutory consumer rights that cannot legally be
					excluded.
				</p>

			</section>



			<!-- =========================
			     7. DIGITAL COMMISSIONS
			     ========================= -->

			<section class="terms-card">

				<span class="section-number">
					07
				</span>

				<h2>
					Digital Commissions
				</h2>

				<p>
					Digital commissions are delivered electronically
					as image files or other agreed digital formats.
				</p>

				<p>
					Please make sure that the email address or other
					contact information you provide is correct.
				</p>

				<p>
					The specific arrangements concerning delivery,
					cancellation and withdrawal of digital content are
					also subject to the applicable consumer protection
					rules.
				</p>

			</section>



			<!-- =========================
			     8. PHYSICAL COMMISSIONS
			     ========================= -->

			<section class="terms-card">

				<span class="section-number">
					08
				</span>

				<h2>
					Physical & Traditional Commissions
				</h2>

				<p>
					I may also offer physical commissions, such as
					traditional artwork, laminated badges or other
					custom-made items.
				</p>

				<p>
					Because these items may be individually made
					according to the customer's specifications,
					different rules may apply to them than to
					standard merchandise.
				</p>

				<p>
					The details of a physical commission, including
					materials, size and finish, will be agreed upon
					before production begins.
				</p>

			</section>



			<!-- =========================
			     9. COPYRIGHT
			     ========================= -->

			<section class="terms-card">

				<span class="section-number">
					09
				</span>

				<h2>
					Copyright & Artwork Usage
				</h2>

				<p>
					Unless otherwise agreed in writing, I retain the
					copyright to artwork that I create.
				</p>

				<p>
					Commissioning artwork does not transfer the
					copyright to the customer.
				</p>

				<p>
					The customer receives permission to use the
					finished commissioned artwork for personal,
					non-commercial purposes.
				</p>


				<div class="usage-grid">

					<div>

						<h3>
							Personal Use
						</h3>

						<ul>

							<li>
								Profile pictures
							</li>

							<li>
								Social media
							</li>

							<li>
								Personal websites
							</li>

							<li>
								Personal wallpapers
							</li>

							<li>
								Personal prints
							</li>

						</ul>

					</div>


					<div>

						<h3>
							Commercial Use
						</h3>

						<ul>

							<li>
								Merchandise for sale
							</li>

							<li>
								Commercial advertising
							</li>

							<li>
								Business branding
							</li>

							<li>
								Products for sale
							</li>

							<li>
								Other commercial exploitation
							</li>

						</ul>

					</div>

				</div>


				<p>
					Commercial use requires a separate agreement.
					Please contact me if you would like to use
					commissioned artwork commercially.
				</p>

			</section>



			<!-- =========================
			     10. CHARACTER OWNERSHIP
			     ========================= -->

			<section class="terms-card">

				<span class="section-number">
					10
				</span>

				<h2>
					Characters & Intellectual Property
				</h2>

				<p>
					Characters, names, logos and other intellectual
					property supplied by the customer remain the
					property of their respective owners.
				</p>

				<p>
					Commissioning artwork does not transfer ownership
					of the underlying character or intellectual property
					to me.
				</p>

				<p>
					Likewise, purchasing a commission does not transfer
					the copyright in my artwork to the customer.
				</p>

			</section>



			<!-- =========================
			     11. PORTFOLIO
			     ========================= -->

			<section class="terms-card">

				<span class="section-number">
					11
				</span>

				<h2>
					Portfolio & Posting
				</h2>

				<p>
					I may display completed commissions on my website,
					in my portfolio, at conventions and on social media
					in order to showcase my work.
				</p>

				<p>
					If you need a commission to remain private, please
					let me know before or during the commission process.
					I will do my best to respect reasonable privacy
					requests.
				</p>

			</section>



			<!-- =========================
			     12. AI
			     ========================= -->

			<section class="terms-card ai-card">

				<span class="section-number">
					12
				</span>

				<h2>
					AI & Machine Learning
				</h2>

				<p>
					I do not use generative AI to create commissioned
					artwork or other artwork offered through this website.
				</p>

				<p>
					My artwork may not be submitted to, uploaded to,
					or otherwise used for training, fine-tuning, testing
					or development of generative AI or machine-learning
					models without my explicit written permission.
				</p>

				<p>
					This includes automated scraping, datasets and
					other services whose purpose includes collecting
					artwork for AI or machine-learning development.
				</p>

				<p class="strong">
					Please do not use my artwork to train or improve
					AI image-generation systems.
				</p>

			</section>



			<!-- =========================
			     13. CUSTOMER RESPONSIBILITIES
			     ========================= -->

			<section class="terms-card">

				<span class="section-number">
					13
				</span>

				<h2>
					Customer Responsibilities
				</h2>

				<p>
					You are responsible for providing accurate
					references, descriptions and other information
					needed to complete your commission.
				</p>

				<p>
					Please make sure that you have the necessary rights
					to any reference material, characters or other
					intellectual property that you ask me to use.
				</p>

				<p>
					I am not responsible for delays caused by missing
					information, unavailable references or delayed
					customer responses.
				</p>

			</section>



			<!-- =========================
			     14. OTHER
			     ========================= -->

			<section class="terms-card">

				<span class="section-number">
					14
				</span>

				<h2>
					A Few Final Things
				</h2>

				<p>
					I reserve the right to refuse a commission request
					for any reason.
				</p>

				<p>
					These terms may be updated from time to time.
					The terms applicable to an existing commission
					will generally be those agreed upon when the
					commission was accepted.
				</p>

				<p>
					If you have a request that isn't covered here,
					please ask! I'm always happy to discuss custom
					projects and unusual ideas.
				</p>

				<p class="friendly">
					Thanks for reading, and have fun! :3
				</p>

			</section>



			<!-- =========================
			     LEGAL LINKS
			     ========================= -->

			<section class="legal-links">

				<p>
					Looking for the formal legal information?
				</p>

				<div>

					<a href="/imprint">
						Imprint
					</a>

					<a href="/privacy">
						Privacy Policy
					</a>

					<a href="/withdrawal">
						Withdrawal Information
					</a>

				</div>

			</section>


		</main>


		<Footer />

	</body>

</html>



<style>

/* =========================
   PAGE
   ========================= */

.terms-page {

	max-width:
		900px;

	margin:
		0 auto;

	padding:
		4rem 1.5rem
		6rem;

}



/* =========================
   HEADING
   ========================= */

.page-heading {

	text-align:
		center;

	margin-bottom:
		3rem;

}


.eyebrow {

	margin:
		0 0 0.7rem;

	color:
		var(--pink-light);

	font-size:
		0.7rem;

	font-weight:
		700;

	letter-spacing:
		0.16em;

}


.page-heading h1 {

	margin:
		0;

	font-size:
		clamp(3rem, 8vw, 5rem);

	line-height:
		1;

	letter-spacing:
		-0.03em;

}


.intro {

	max-width:
		650px;

	margin:
		1rem auto 0;

	color:
		var(--text-muted);

	font-size:
		1rem;

	line-height:
		1.6;

}



/* =========================
   CARDS
   ========================= */

.terms-card {

	position:
		relative;

	margin-bottom:
		1.2rem;

	padding:
		2rem;

	border:
		1px solid
		rgba(255, 130, 225, 0.28);

	border-radius:
		22px;

	background:
		linear-gradient(
			145deg,
			rgba(180, 20, 150, 0.14),
			rgba(40, 10, 50, 0.22)
		);

	box-shadow:
		0 0 18px
		rgba(255, 80, 200, 0.05);

}


.terms-card.highlight {

	border-color:
		rgba(255, 130, 225, 0.55);

	box-shadow:
		0 0 25px
		rgba(255, 80, 200, 0.12);

}



/* =========================
   SECTION NUMBER
   ========================= */

.section-number {

	display:
		inline-block;

	margin-bottom:
		0.7rem;

	color:
		var(--pink-light);

	font-size:
		0.7rem;

	font-weight:
		700;

	letter-spacing:
		0.12em;

}



/* =========================
   HEADINGS
   ========================= */

.terms-card h2 {

	margin:
		0 0 1rem;

	font-size:
		1.5rem;

	line-height:
		1.2;

}


.terms-card h3 {

	margin:
		1.5rem 0 0.5rem;

	font-size:
		0.95rem;

	color:
		rgba(255, 255, 255, 0.9);

}


.terms-card h3:first-of-type {

	margin-top:
		1rem;

}



/* =========================
   TEXT
   ========================= */

.terms-card p {

	margin:
		0 0 1rem;

	color:
		var(--text-muted);

	font-size:
		0.92rem;

	line-height:
		1.65;

}


.terms-card p:last-child {

	margin-bottom:
		0;

}


.terms-card .strong {

	color:
		white;

	font-weight:
		600;

}


.note {

	margin-top:
		1.5rem !important;

	padding-top:
		1rem;

	border-top:
		1px solid
		rgba(255, 255, 255, 0.08);

	font-size:
		0.8rem !important;

}



/* =========================
   USAGE GRID
   ========================= */

.usage-grid {

	display:
		grid;

	grid-template-columns:
		repeat(2, 1fr);

	gap:
		1rem;

	margin:
		1.5rem 0;

}


.usage-grid > div {

	padding:
		1.2rem;

	border:
		1px solid
		rgba(255, 130, 225, 0.18);

	border-radius:
		14px;

	background:
		rgba(0, 0, 0, 0.12);

}


.usage-grid h3 {

	margin:
		0 0 0.7rem;

	color:
		var(--pink-light);

	font-size:
		0.9rem;

}


.usage-grid ul {

	margin:
		0;

	padding-left:
		1.2rem;

	color:
		var(--text-muted);

	font-size:
		0.82rem;

	line-height:
		1.8;

}



/* =========================
   AI SECTION
   ========================= */

.ai-card {

	border-color:
		rgba(180, 100, 255, 0.35);

}


.ai-card .section-number {

	color:
		#d99aff;

}



/* =========================
   FRIENDLY ENDING
   ========================= */

.friendly {

	margin-top:
		1.5rem !important;

	color:
		var(--pink-light) !important;

	font-size:
		1rem !important;

	font-weight:
		600;

}



/* =========================
   LEGAL LINKS
   ========================= */

.legal-links {

	padding:
		2rem 1rem;

	text-align:
		center;

	color:
		var(--text-muted);

}


.legal-links p {

	margin:
		0 0 1rem;

	font-size:
		0.8rem;

}


.legal-links div {

	display:
		flex;

	justify-content:
		center;

	flex-wrap:
		wrap;

	gap:
		1.5rem;

}


.legal-links a {

	color:
		var(--pink-light);

	font-size:
		0.85rem;

	text-decoration:
		none;

}


.legal-links a:hover {

	text-decoration:
		underline;

}



/* =========================
   MOBILE
   ========================= */

@media (max-width: 650px) {

	.terms-page {

		padding:
			2.5rem 0.8rem
			4rem;

	}


	.terms-card {

		padding:
			1.4rem;

		border-radius:
			18px;

	}


	.terms-card h2 {

		font-size:
			1.3rem;

	}


	.terms-card p {

		font-size:
			0.88rem;

	}


	.usage-grid {

		grid-template-columns:
			1fr;

		gap:
			0.8rem;

	}

}

</style>
