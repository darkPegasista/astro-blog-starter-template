---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>

<html lang="en">

	<head>

		<BaseHead
			title="Shopping Cart"
			description="Your shopping cart"
		/>

	</head>


	<body>

		<Header />


		<main class="cart-page">


			<!-- =========================
			     TITLE
			     ========================= -->

			<div class="cart-header">

				<p class="eyebrow">
					✦ YOUR SELECTION ✦
				</p>

				<h1>
					Shopping Cart
				</h1>

			</div>



			<!-- =========================
			     CART
			     ========================= -->

			<div id="cart-container">

				<p class="loading">
					Loading cart...
				</p>

			</div>


		</main>


		<Footer />



		<script>

			const container =
				document.querySelector(
					'#cart-container'
				);



			// =========================
			// GET CART
			// =========================

			function getCart() {

				try {

					return JSON.parse(
						localStorage.getItem(
							'cart'
						) || '[]'
					);

				} catch {

					return [];

				}

			}



			// =========================
			// SAVE CART
			// =========================

			function saveCart(cart) {

				localStorage.setItem(
					'cart',
					JSON.stringify(cart)
				);

			}



			// =========================
			// UPDATE HEADER COUNT
			// =========================

			function updateCartCount() {

				const cart =
					getCart();


				const totalItems =
					cart.reduce(
						(total, item) =>
							total + item.quantity,
						0
					);


				const cartCount =
					document.querySelector(
						'#cart-count'
					);


				if (cartCount) {

					cartCount.textContent =
						String(totalItems);

				}

			}



			// =========================
			// RENDER CART
			// =========================

			function renderCart() {

				if (!container) {

					return;

				}


				const cart =
					getCart();


				updateCartCount();



				// =========================
				// EMPTY CART
				// =========================

				if (cart.length === 0) {

					container.innerHTML = `

						<div class="empty-cart">

							<div class="empty-icon">
								🛒
							</div>

							<h2>
								Your cart is empty
							</h2>

							<p>
								Looks like you haven't
								added anything yet.
							</p>

							<a
								href="/merch"
								class="continue-button"
							>
								Browse Merch
							</a>

						</div>

					`;

					return;

				}



				// =========================
				// CALCULATE SUBTOTAL
				// =========================

				let subtotal = 0;


				const items =
					cart.map(
						(item) => {

							const itemTotal =
								item.price *
								item.quantity;


							subtotal +=
								itemTotal;


							return `

								<article
									class="cart-item"
									data-slug="${item.slug}"
								>


									<!-- IMAGE -->

									<a
										class="item-image"
										href="/merch/${item.category ?? ''}/${item.slug}"
									>

										<img
											src="${item.image}"
											alt="${item.name}"
										/>

									</a>



									<!-- DETAILS -->

									<div class="item-details">

										<h2>
											${item.name}
										</h2>


										<p class="item-price">
											€${item.price.toFixed(2)}
											<span>
												each
											</span>
										</p>



										<div class="item-bottom">


											<!-- QUANTITY -->

											<div class="quantity-control">

												<button
													type="button"
													class="quantity-minus"
													data-slug="${item.slug}"
													aria-label="Decrease quantity"
												>
													−
												</button>


												<span>
													${item.quantity}
												</span>


												<button
													type="button"
													class="quantity-plus"
													data-slug="${item.slug}"
													aria-label="Increase quantity"
												>
													+
												</button>

											</div>



											<!-- REMOVE -->

											<button
												type="button"
												class="remove-item"
												data-slug="${item.slug}"
											>
												Remove
											</button>

										</div>

									</div>



									<!-- ITEM TOTAL -->

									<div class="item-total">

										€${itemTotal.toFixed(2)}

									</div>


								</article>

							`;

						}
					).join('');



				// =========================
				// FULL CART
				// =========================

				container.innerHTML = `

					<div class="cart-layout">


						<!-- ITEMS -->

						<div class="cart-items">

							${items}


							<a
								href="/merch"
								class="continue-shopping"
							>
								← Continue shopping
							</a>

						</div>



						<!-- SUMMARY -->

						<aside class="cart-summary">


							<h2>
								Order Summary
							</h2>


							<div class="summary-line">

								<span>
									Subtotal
								</span>

								<strong>
									€${subtotal.toFixed(2)}
								</strong>

							</div>


							<div class="summary-line muted">

								<span>
									Shipping
								</span>

								<span>
									Calculated at checkout
								</span>

							</div>


							<div class="summary-line muted">

								<span>
									Taxes
								</span>

								<span>
									Calculated at checkout
								</span>

							</div>


							<div class="summary-divider">
							</div>


							<div class="summary-total">

								<span>
									Total
								</span>

								<strong>
									€${subtotal.toFixed(2)}
								</strong>

							</div>


							<button
								type="button"
								class="checkout-button"
								disabled
							>
								Checkout coming soon
							</button>


							<p class="checkout-note">
								Checkout and secure payment
								will be available soon.
							</p>


						</aside>

					</div>

				`;


				addListeners();

			}



			// =========================
			// EVENT LISTENERS
			// =========================

			function addListeners() {


				// Minus

				document
					.querySelectorAll(
						'.quantity-minus'
					)
					.forEach(
						(button) => {

							button.addEventListener(
								'click',
								() => {

									changeQuantity(
										button.dataset.slug,
										-1
									);

								}
							);

						}
					);



				// Plus

				document
					.querySelectorAll(
						'.quantity-plus'
					)
					.forEach(
						(button) => {

							button.addEventListener(
								'click',
								() => {

									changeQuantity(
										button.dataset.slug,
										1
									);

								}
							);

						}
					);



				// Remove

				document
					.querySelectorAll(
						'.remove-item'
					)
					.forEach(
						(button) => {

							button.addEventListener(
								'click',
								() => {

									removeItem(
										button.dataset.slug
									);

								}
							);

						}
					);

			}



			// =========================
			// CHANGE QUANTITY
			// =========================

			function changeQuantity(
				slug,
				change
			) {

				const cart =
					getCart();


				const item =
					cart.find(
						(item) =>
							item.slug === slug
					);


				if (!item) {

					return;

				}


				item.quantity +=
					change;



				if (item.quantity <= 0) {

					removeItem(slug);

					return;

				}


				saveCart(cart);

				renderCart();

			}



			// =========================
			// REMOVE ITEM
			// =========================

			function removeItem(slug) {

				const cart =
					getCart().filter(
						(item) =>
							item.slug !== slug
					);


				saveCart(cart);

				renderCart();

			}



			// =========================
			// INITIAL RENDER
			// =========================

			renderCart();

		</script>

	</body>

</html>



<style is:global>

	/* ========================================
	   CART PAGE
	   ======================================== */

	.cart-page {

		width: 100%;
		max-width: 1100px;

		margin: 0 auto;

		padding:
			4rem 1.5rem 7rem;

		box-sizing: border-box;

	}



	/* ========================================
	   HEADER
	   ======================================== */

	.cart-header {

		text-align: center;

		margin-bottom: 3.5rem;

	}


	.eyebrow {

		margin:
			0 0 0.8rem;

		color:
			var(--pink-light);

		font-size:
			0.72rem;

		font-weight:
			700;

		letter-spacing:
			0.16em;

		text-transform:
			uppercase;

		text-shadow:
			0 0 12px
			rgba(255, 100, 220, 0.7);

	}


	.cart-header h1 {

		margin: 0;

		font-size:
			clamp(2.5rem, 6vw, 4.2rem);

		line-height:
			1;

		font-weight:
			700;

	}



	/* ========================================
	   MAIN TWO-COLUMN LAYOUT
	   ======================================== */

	.cart-layout {

		display: grid;

		grid-template-columns:
			minmax(0, 1fr)
			320px;

		gap:
			2rem;

		align-items:
			start;

	}



	/* ========================================
	   CART ITEMS CONTAINER
	   ======================================== */

	.cart-items {

		display:
			flex;

		flex-direction:
			column;

		gap:
			1rem;

		padding:
			1.4rem;

		border:
			1px solid
			rgba(255, 130, 225, 0.22);

		border-radius:
			24px;

		background:
			linear-gradient(
				145deg,
				rgba(180, 20, 150, 0.10),
				rgba(35, 10, 40, 0.32)
			);

		box-shadow:
			0 0 30px
			rgba(255, 80, 200, 0.05);

	}



	/* ========================================
	   INDIVIDUAL PRODUCT
	   ======================================== */

	.cart-item {

		position:
			relative;

		display:
			grid;

		grid-template-columns:
			110px minmax(0, 1fr) auto;

		gap:
			1.25rem;

		align-items:
			center;

		padding:
			0.9rem;

		border:
			1px solid
			rgba(255, 130, 225, 0.22);

		border-radius:
			18px;

		background:
			rgba(255, 255, 255, 0.025);

		box-shadow:
			inset 0 0 20px
			rgba(255, 80, 200, 0.025);

		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease,
			transform 0.2s ease;

	}


	.cart-item:hover {

		border-color:
			rgba(255, 130, 225, 0.55);

		box-shadow:
			0 0 22px
			rgba(255, 80, 200, 0.10);

		transform:
			translateY(-1px);

	}



	/* ========================================
	   PRODUCT IMAGE
	   ======================================== */

	.item-image {

		display:
			block;

		width:
			110px;

		height:
			110px;

		overflow:
			hidden;

		border-radius:
			14px;

		border:
			1px solid
			rgba(255, 130, 225, 0.18);

		background:
			rgba(255, 255, 255, 0.025);

	}


	.item-image img {

		display:
			block;

		width:
			100%;

		height:
			100%;

		object-fit:
			cover;

		transition:
			transform 0.3s ease;

	}


	.item-image:hover img {

		transform:
			scale(1.04);

	}



	/* ========================================
	   PRODUCT INFORMATION
	   ======================================== */

	.item-details {

		min-width:
			0;

	}


	.item-details h2 {

		margin:
			0 0 0.4rem;

		font-size:
			1.05rem;

		font-weight:
			700;

		line-height:
			1.3;

	}


	.item-price {

		margin:
			0;

		color:
			var(--text-muted);

		font-size:
			0.82rem;

	}


	.item-price span {

		opacity:
			0.55;

	}



	/* ========================================
	   QUANTITY + REMOVE
	   ======================================== */

	.item-bottom {

		display:
			flex;

		align-items:
			center;

		gap:
			1rem;

		margin-top:
			0.9rem;

	}


	.quantity-control {

		display:
			flex;

		align-items:
			center;

		height:
			34px;

		overflow:
			hidden;

		border:
			1px solid
			rgba(255, 130, 225, 0.4);

		border-radius:
			9px;

		background:
			rgba(255, 255, 255, 0.025);

	}


	.quantity-control button {

		width:
			32px;

		height:
			34px;

		padding:
			0;

		border:
			none;

		background:
			transparent;

		color:
			white;

		font-family:
			inherit;

		font-size:
			1rem;

		cursor:
			pointer;

		transition:
			background 0.2s ease;

	}


	.quantity-control button:hover {

		background:
			rgba(255, 80, 200, 0.16);

	}


	.quantity-control span {

		width:
			32px;

		text-align:
			center;

		font-size:
			0.8rem;

		font-weight:
			600;

	}



	/* ========================================
	   REMOVE BUTTON
	   ======================================== */

	.remove-item {

		padding:
			0;

		border:
			none;

		background:
			transparent;

		color:
			rgba(255, 255, 255, 0.42);

		font-family:
			inherit;

		font-size:
			0.75rem;

		cursor:
			pointer;

		transition:
			color 0.2s ease,
			text-shadow 0.2s ease;

	}


	.remove-item:hover {

		color:
			var(--pink-light);

		text-shadow:
			0 0 8px
			rgba(255, 100, 220, 0.6);

	}



	/* ========================================
	   ITEM TOTAL
	   ======================================== */

	.item-total {

		align-self:
			center;

		padding-right:
			0.4rem;

		font-size:
			0.95rem;

		font-weight:
			700;

		white-space:
			nowrap;

	}



	/* ========================================
	   CONTINUE SHOPPING
	   ======================================== */

	.continue-shopping {

		display:
			inline-flex;

		align-items:
			center;

		width:
			fit-content;

		margin-top:
			0.5rem;

		padding:
			0.7rem 1rem;

		border:
			1px solid
			rgba(255, 130, 225, 0.35);

		border-radius:
			10px;

		background:
			rgba(255, 255, 255, 0.02);

		color:
			rgba(255, 255, 255, 0.75);

		font-size:
			0.78rem;

		text-decoration:
			none;

		transition:
			border-color 0.2s ease,
			background 0.2s ease,
			color 0.2s ease,
			box-shadow 0.2s ease;

	}


	.continue-shopping:hover {

		color:
			white;

		border-color:
			rgba(255, 130, 225, 0.7);

		background:
			rgba(255, 70, 200, 0.08);

		box-shadow:
			0 0 15px
			rgba(255, 80, 200, 0.12);

	}



	/* ========================================
	   ORDER SUMMARY
	   ======================================== */

	.cart-summary {

		position:
			sticky;

		top:
			1.5rem;

		padding:
			1.5rem;

		border:
			1px solid
			rgba(255, 130, 225, 0.45);

		border-radius:
			22px;

		background:
			linear-gradient(
				145deg,
				rgba(180, 20, 150, 0.15),
				rgba(40, 8, 45, 0.30)
			);

		box-shadow:
			0 0 30px
			rgba(255, 80, 200, 0.08),
			inset 0 0 25px
			rgba(255, 80, 200, 0.025);

		backdrop-filter:
			blur(12px);

	}


	.cart-summary h2 {

		margin:
			0 0 1.5rem;

		font-size:
			1.2rem;

	}



	/* ========================================
	   SUMMARY LINES
	   ======================================== */

	.summary-line {

		display:
			flex;

		justify-content:
			space-between;

		align-items:
			flex-start;

		gap:
			1rem;

		margin-bottom:
			1rem;

		font-size:
			0.85rem;

	}


	.summary-line span:last-child {

		text-align:
			right;

	}


	.summary-line.muted {

		color:
			var(--text-muted);

		font-size:
			0.75rem;

	}



	/* ========================================
	   DIVIDER
	   ======================================== */

	.summary-divider {

		height:
			1px;

		margin:
			1.2rem 0;

		background:
			rgba(255, 130, 225, 0.2);

	}



	/* ========================================
	   TOTAL
	   ======================================== */

	.summary-total {

		display:
			flex;

		justify-content:
			space-between;

		align-items:
			center;

		margin-bottom:
			1.5rem;

	}


	.summary-total span {

		font-size:
			1rem;

		font-weight:
			600;

	}


	.summary-total strong {

		color:
			var(--pink-light);

		font-size:
			1.35rem;

		text-shadow:
			0 0 12px
			rgba(255, 100, 220, 0.55);

	}



	/* ========================================
	   CHECKOUT BUTTON
	   ======================================== */

	.checkout-button {

		width:
			100%;

		padding:
			0.95rem;

		border:
			1px solid
			rgba(255, 130, 225, 0.65);

		border-radius:
			12px;

		background:
			rgba(255, 70, 200, 0.10);

		color:
			white;

		font-family:
			inherit;

		font-size:
			0.85rem;

		font-weight:
			700;

		cursor:
			not-allowed;

		opacity:
			0.55;

		box-shadow:
			0 0 15px
			rgba(255, 80, 200, 0.08);

	}


	.checkout-note {

		margin:
			0.8rem 0 0;

		color:
			var(--text-muted);

		font-size:
			0.68rem;

		line-height:
			1.5;

		text-align:
			center;

	}



	/* ========================================
	   EMPTY CART
	   ======================================== */

	.empty-cart {

		padding:
			5rem 2rem;

		text-align:
			center;

		border:
			1px solid
			rgba(255, 130, 225, 0.25);

		border-radius:
			24px;

		background:
			linear-gradient(
				145deg,
				rgba(180, 20, 150, 0.10),
				rgba(40, 8, 45, 0.20)
			);

	}


	.empty-icon {

		margin-bottom:
			1rem;

		font-size:
			2.5rem;

	}


	.empty-cart h2 {

		margin:
			0 0 0.5rem;

		font-size:
			1.4rem;

	}


	.empty-cart p {

		margin:
			0 0 1.5rem;

		color:
			var(--text-muted);

		font-size:
			0.9rem;

	}


	.continue-button {

		display:
			inline-block;

		padding:
			0.8rem 1.5rem;

		border:
			1px solid
			rgba(255, 130, 225, 0.6);

		border-radius:
			10px;

		background:
			rgba(255, 70, 200, 0.10);

		color:
			white;

		text-decoration:
			none;

		font-size:
			0.85rem;

		font-weight:
			600;

		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease,
			background 0.2s ease;

	}


	.continue-button:hover {

		transform:
			translateY(-2px);

		background:
			rgba(255, 70, 200, 0.18);

		box-shadow:
			0 0 20px
			rgba(255, 80, 200, 0.25);

	}



	/* ========================================
	   TABLET
	   ======================================== */

	@media (max-width: 850px) {

		.cart-layout {

			grid-template-columns:
				1fr;

		}


		.cart-summary {

			position:
				static;

		}

	}



	/* ========================================
	   MOBILE
	   ======================================== */

	@media (max-width: 600px) {

		.cart-page {

			padding:
				2.5rem 0.8rem 4rem;

		}


		.cart-header {

			margin-bottom:
				2rem;

		}


		.cart-header h1 {

			font-size:
				2.3rem;

		}


		.cart-items {

			padding:
				0.8rem;

			border-radius:
				20px;

		}


		.cart-item {

			grid-template-columns:
				76px minmax(0, 1fr);

			gap:
				0.9rem;

			padding:
				0.75rem;

		}


		.item-image {

			width:
				76px;

			height:
				76px;

			border-radius:
				11px;

		}


		.item-details h2 {

			font-size:
				0.9rem;

		}


		.item-price {

			font-size:
				0.75rem;

		}


		.item-bottom {

			margin-top:
				0.7rem;

			gap:
				0.7rem;

		}


		.item-total {

			position:
				absolute;

			top:
				0.85rem;

			right:
				0.8rem;

			padding:
				0;

			font-size:
				0.82rem;

		}


		.quantity-control {

			height:
