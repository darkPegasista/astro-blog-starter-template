---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>

<html lang="en">

	<head>

		<BaseHead
			title="Shopping Cart"
			description="Your shopping cart"
		/>

	</head>


	<body>

		<Header />


		<main class="cart-page">


			<!-- =========================
			     TITLE
			     ========================= -->

			<div class="cart-header">

				<p class="eyebrow">
					✦ YOUR SELECTION ✦
				</p>

				<h1>
					Shopping Cart
				</h1>

			</div>



			<!-- =========================
			     CART
			     ========================= -->

			<div id="cart-container">

				<p class="loading">
					Loading cart...
				</p>

			</div>


		</main>


		<Footer />



		<script>

			const container =
				document.querySelector(
					'#cart-container'
				);



			// =========================
			// GET CART
			// =========================

			function getCart() {

				try {

					return JSON.parse(
						localStorage.getItem(
							'cart'
						) || '[]'
					);

				} catch {

					return [];

				}

			}



			// =========================
			// SAVE CART
			// =========================

			function saveCart(cart) {

				localStorage.setItem(
					'cart',
					JSON.stringify(cart)
				);

			}



			// =========================
			// UPDATE HEADER COUNT
			// =========================

			function updateCartCount() {

				const cart =
					getCart();


				const totalItems =
					cart.reduce(
						(total, item) =>
							total + item.quantity,
						0
					);


				const cartCount =
					document.querySelector(
						'#cart-count'
					);


				if (cartCount) {

					cartCount.textContent =
						String(totalItems);

				}

			}



			// =========================
			// RENDER CART
			// =========================

			function renderCart() {

				if (!container) {

					return;

				}


				const cart =
					getCart();


				updateCartCount();



				// =========================
				// EMPTY CART
				// =========================

				if (cart.length === 0) {

					container.innerHTML = `

						<div class="empty-cart">

							<div class="empty-icon">
								🛒
							</div>

							<h2>
								Your cart is empty
							</h2>

							<p>
								Looks like you haven't
								added anything yet.
							</p>

							<a
								href="/merch"
								class="continue-button"
							>
								Browse Merch
							</a>

						</div>

					`;

					return;

				}



				// =========================
				// CALCULATE SUBTOTAL
				// =========================

				let subtotal = 0;


				const items =
					cart.map(
						(item) => {

							const itemTotal =
								item.price *
								item.quantity;


							subtotal +=
								itemTotal;


							return `

								<article
									class="cart-item"
									data-slug="${item.slug}"
								>


									<!-- IMAGE -->

									<a
										class="item-image"
										href="/merch/${item.category ?? ''}/${item.slug}"
									>

										<img
											src="${item.image}"
											alt="${item.name}"
										/>

									</a>



									<!-- DETAILS -->

									<div class="item-details">

										<h2>
											${item.name}
										</h2>


										<p class="item-price">
											€${item.price.toFixed(2)}
											<span>
												each
											</span>
										</p>



										<div class="item-bottom">


											<!-- QUANTITY -->

											<div class="quantity-control">

												<button
													type="button"
													class="quantity-minus"
													data-slug="${item.slug}"
													aria-label="Decrease quantity"
												>
													−
												</button>


												<span>
													${item.quantity}
												</span>


												<button
													type="button"
													class="quantity-plus"
													data-slug="${item.slug}"
													aria-label="Increase quantity"
												>
													+
												</button>

											</div>



											<!-- REMOVE -->

											<button
												type="button"
												class="remove-item"
												data-slug="${item.slug}"
											>
												Remove
											</button>

										</div>

									</div>



									<!-- ITEM TOTAL -->

									<div class="item-total">

										€${itemTotal.toFixed(2)}

									</div>


								</article>

							`;

						}
					).join('');



				// =========================
				// FULL CART
				// =========================

				container.innerHTML = `

					<div class="cart-layout">


						<!-- ITEMS -->

						<div class="cart-items">

							${items}


							<a
								href="/merch"
								class="continue-shopping"
							>
								← Continue shopping
							</a>

						</div>



						<!-- SUMMARY -->

						<aside class="cart-summary">


							<h2>
								Order Summary
							</h2>


							<div class="summary-line">

								<span>
									Subtotal
								</span>

								<strong>
									€${subtotal.toFixed(2)}
								</strong>

							</div>


							<div class="summary-line muted">

								<span>
									Shipping
								</span>

								<span>
									Calculated at checkout
								</span>

							</div>


							<div class="summary-line muted">

								<span>
									Taxes
								</span>

								<span>
									Calculated at checkout
								</span>

							</div>


							<div class="summary-divider">
							</div>


							<div class="summary-total">

								<span>
									Total
								</span>

								<strong>
									€${subtotal.toFixed(2)}
								</strong>

							</div>


							<button
								type="button"
								class="checkout-button"
								disabled
							>
								Checkout coming soon
							</button>


							<p class="checkout-note">
								Checkout and secure payment
								will be available soon.
							</p>


						</aside>

					</div>

				`;


				addListeners();

			}



			// =========================
			// EVENT LISTENERS
			// =========================

			function addListeners() {


				// Minus

				document
					.querySelectorAll(
						'.quantity-minus'
					)
					.forEach(
						(button) => {

							button.addEventListener(
								'click',
								() => {

									changeQuantity(
										button.dataset.slug,
										-1
									);

								}
							);

						}
					);



				// Plus

				document
					.querySelectorAll(
						'.quantity-plus'
					)
					.forEach(
						(button) => {

							button.addEventListener(
								'click',
								() => {

									changeQuantity(
										button.dataset.slug,
										1
									);

								}
							);

						}
					);



				// Remove

				document
					.querySelectorAll(
						'.remove-item'
					)
					.forEach(
						(button) => {

							button.addEventListener(
								'click',
								() => {

									removeItem(
										button.dataset.slug
									);

								}
							);

						}
					);

			}



			// =========================
			// CHANGE QUANTITY
			// =========================

			function changeQuantity(
				slug,
				change
			) {

				const cart =
					getCart();


				const item =
					cart.find(
						(item) =>
							item.slug === slug
					);


				if (!item) {

					return;

				}


				item.quantity +=
					change;



				if (item.quantity <= 0) {

					removeItem(slug);

					return;

				}


				saveCart(cart);

				renderCart();

			}



			// =========================
			// REMOVE ITEM
			// =========================

			function removeItem(slug) {

				const cart =
					getCart().filter(
						(item) =>
							item.slug !== slug
					);


				saveCart(cart);

				renderCart();

			}



			// =========================
			// INITIAL RENDER
			// =========================

			renderCart();

		</script>

	</body>

</html>



<style>


	/* =========================
	   PAGE
	   ========================= */

	.cart-page {

		max-width:
			1100px;

		margin:
			0 auto;

		padding:
			3rem 1.5rem 6rem;

	}



	/* =========================
	   HEADER
	   ========================= */

	.cart-header {

		text-align:
			center;

		margin-bottom:
			3rem;

	}


	.eyebrow {

		margin:
			0 0 0.8rem;

		color:
			var(--pink-light);

		font-size:
			0.75rem;

		font-weight:
			700;

		letter-spacing:
			0.15em;

	}


	.cart-header h1 {

		margin:
			0;

		font-size:
			clamp(
				2.5rem,
				7vw,
				4rem
			);

		line-height:
			1;

	}



	/* =========================
	   CART LAYOUT
	   ========================= */

	.cart-layout {

		display:
			grid;

		grid-template-columns:
			1fr 320px;

		gap:
			2rem;

		align-items:
			start;

	}



	/* =========================
	   ITEMS
	   ========================= */

	.cart-items {

		display:
			flex;

		flex-direction:
			column;

		gap:
			1rem;

	}


	.cart-item {

		display:
			grid;

		grid-template-columns:
			120px 1fr auto;

		gap:
			1.5rem;

		align-items:
			center;

		padding:
			1rem;

		border:
			1px solid
			rgba(255, 130, 225, 0.3);

		border-radius:
			20px;

		background:
			linear-gradient(
				145deg,
				rgba(180, 20, 150, 0.15),
				rgba(80, 10, 80, 0.12)
			);

		box-shadow:
			0 0 20px
			rgba(255, 80, 200, 0.06);

		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease;

	}


	.cart-item:hover {

		border-color:
			rgba(255, 130, 225, 0.6);

		box-shadow:
			0 0 25px
			rgba(255, 80, 200, 0.12);

	}



	/* =========================
	   ITEM IMAGE
	   ========================= */

	.item-image {

		width:
			120px;

		height:
			120px;

		overflow:
			hidden;

		border-radius:
			14px;

		border:
			1px solid
			rgba(255, 130, 225, 0.2);

	}


	.item-image img {

		width:
			100%;

		height:
			100%;

		display:
			block;

		object-fit:
			cover;

		transition:
			transform 0.3s ease;

	}


	.item-image:hover img {

		transform:
			scale(1.04);

	}



	/* =========================
	   ITEM DETAILS
	   ========================= */

	.item-details {

		min-width:
			0;

	}


	.item-details h2 {

		margin:
			0 0 0.4rem;

		font-size:
			1.15rem;

	}


	.item-price {

		margin:
			0;

		color:
			var(--text-muted);

		font-size:
			0.9rem;

	}


	.item-price span {

		opacity:
			0.6;

	}



	/* =========================
	   ITEM BOTTOM
	   ========================= */

	.item-bottom {

		display:
			flex;

		align-items:
			center;

		gap:
			1rem;

		margin-top:
			1.2rem;

	}



	/* =========================
	   QUANTITY
	   ========================= */

	.quantity-control {

		display:
			flex;

		align-items:
			center;

		border:
			1px solid
			rgba(255, 130, 225, 0.4);

		border-radius:
			10px;

		overflow:
			hidden;

	}


	.quantity-control button {

		width:
			32px;

		height:
			32px;

		border:
			none;

		background:
			rgba(255, 255, 255, 0.04);

		color:
			white;

		font-family:
			inherit;

		font-size:
			1rem;

		cursor:
			pointer;

		transition:
			background 0.2s ease;

	}


	.quantity-control button:hover {

		background:
			rgba(255, 70, 200, 0.18);

	}


	.quantity-control span {

		width:
			35px;

		text-align:
			center;

		font-size:
			0.9rem;

		font-weight:
			600;

	}



	/* =========================
	   REMOVE
	   ========================= */

	.remove-item {

		padding:
			0;

		border:
			none;

		background:
			transparent;

		color:
			rgba(255, 255, 255, 0.45);

		font-family:
			inherit;

		font-size:
			0.8rem;

		cursor:
			pointer;

		transition:
			color 0.2s ease;

	}


	.remove-item:hover {

		color:
			var(--pink-light);

	}



	/* =========================
	   ITEM TOTAL
	   ========================= */

	.item-total {

		font-size:
			1rem;

		font-weight:
			700;

		white-space:
			nowrap;

	}



	/* =========================
	   CONTINUE SHOPPING
	   ========================= */

	.continue-shopping {

		margin-top:
			0.5rem;

		color:
			var(--pink-light);

		font-size:
			0.85rem;

		text-decoration:
			none;

	}


	.continue-shopping:hover {

		color:
			white;

	}



	/* =========================
	   SUMMARY
	   ========================= */

	.cart-summary {

		position:
			sticky;

		top:
			1.5rem;

		padding:
			1.5rem;

		border:
			1px solid
			rgba(255, 130, 225, 0.4);

		border-radius:
			20px;

		background:
			linear-gradient(
				145deg,
				rgba(180, 20, 150, 0.17),
				rgba(80, 10, 80, 0.14)
			);

		box-shadow:
			0 0 25px
			rgba(255, 80, 200, 0.08);

	}


	.cart-summary h2 {

		margin:
			0 0 1.5rem;

		font-size:
			1.2rem;

	}



	/* =========================
	   SUMMARY LINES
	   ========================= */

	.summary-line {

		display:
			flex;

		justify-content:
			space-between;

		gap:
			1rem;

		margin-bottom:
			1rem;

		font-size:
			0.9rem;

	}


	.summary-line.muted {

		color:
			var(--text-muted);

		font-size:
			0.78rem;

	}


	.summary-line.muted span:last-child {

		text-align:
			right;

	}



	/* =========================
	   DIVIDER
	   ========================= */

	.summary-divider {

		height:
			1px;

		margin:
			1.2rem 0;

		background:
			rgba(255, 130, 225, 0.2);

	}



	/* =========================
	   TOTAL
	   ========================= */

	.summary-total {

		display:
			flex;

		justify-content:
			space-between;

		align-items:
			center;

		margin-bottom:
			1.5rem;

		font-size:
			1.1rem;

	}


	.summary-total strong {

		font-size:
			1.3rem;

	}



	/* =========================
	   CHECKOUT
	   ========================= */

	.checkout-button {

		width:
			100%;

		padding:
			1rem;

		border:
			1px solid
			rgba(255, 130, 225, 0.6);

		border-radius:
			12px;

		background:
			rgba(255, 70, 200, 0.12);

		color:
			white;

		font-family:
			inherit;

		font-size:
			0.95rem;

		font-weight:
			700;

		cursor:
			not-allowed;

		opacity:
			0.55;

	}


	.checkout-note {

		margin:
			0.8rem 0 0;

		color:
			var(--text-muted);

		font-size:
			0.7rem;

		line-height:
			1.5;

		text-align:
			center;

	}



	/* =========================
	   EMPTY CART
	   ========================= */

	.empty-cart {

		padding:
			5rem 1rem;

		text-align:
			center;

		border:
			1px solid
			rgba(255, 130, 225, 0.25);

		border-radius:
			24px;

		background:
			rgba(180, 20, 150, 0.08);

	}


	.empty-icon {

		font-size:
			2.5rem;

		margin-bottom:
			1rem;

	}


	.empty-cart h2 {

		margin:
			0 0 0.5rem;

		font-size:
			1.4rem;

	}


	.empty-cart p {

		margin:
			0 0 1.5rem;

		color:
			var(--text-muted);

	}


	.continue-button {

		display:
			inline-block;

		padding:
			0.8rem 1.5rem;

		border:
			1px solid
			rgba(255, 130, 225, 0.6);

		border-radius:
			10px;

		background:
			rgba(255, 70, 200, 0.1);

		color:
			white;

		text-decoration:
			none;

		font-weight:
			600;

		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease,
			background 0.2s ease;

	}


	.continue-button:hover {

		transform:
			translateY(-2px);

		background:
			rgba(255, 70, 200, 0.18);

		box-shadow:
			0 0 20px
			rgba(255, 80, 200, 0.25);

	}



	/* =========================
	   MOBILE
	   ========================= */

	@media (max-width: 800px) {

		.cart-page {

			padding:
				2rem 0.8rem
				4rem;

		}


		.cart-layout {

			grid-template-columns:
				1fr;

		}


		.cart-summary {

			position:
				static;

		}

	}



	@media (max-width: 600px) {

		.cart-item {

			grid-template-columns:
				85px 1fr;

			gap:
				1rem;

		}


		.item-image {

			width:
				85px;

			height:
				85px;

		}


		.item-total {

			grid-column:
				2;

			grid-row:
				1;

			justify-self:
				end;

			align-self:
				start;

			margin-top:
				0.1rem;

		}


		.item-details {

			grid-column:
				2;

		}


		.item-bottom {

			flex-wrap:
				wrap;

		}

	}

</style>
