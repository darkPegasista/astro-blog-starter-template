---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const gallery = [
	{
		image: '/gallery-01.webp',
		title: 'Nightmare Moon',
		category: 'Digital Illustration',
		original: 'https://derpibooru.org/images/3480053',
	},

	{
		image: '/gallery-02.webp',
		title: 'Fran Bow - Ithersta',
		category: 'Digital Illustration',
		original: 'https://derpibooru.org/images/3764948',
	},

	{
		image: '/gallery-03.webp',
		title: 'Twilight Sparkle Valentines YCH',
		category: 'Digital Illustration',
		original: 'https://derpibooru.org/images/3296271',
	},

	{
		image: '/gallery-04.webp',
		title: 'Lunar Dash Badge',
		category: 'Traditional Illustration',
		original: 'https://derpibooru.org/images/3134028',
	},

	{
		image: '/gallery-05.webp',
		title: 'Royal Sisters',
		category: 'Digital Illustration',
		original: 'https://derpibooru.org/images/3107362',
	},

	{
		image: '/gallery-06.webp',
		title: 'Luna',
		category: 'Digital Illustration',
		original: 'https://derpibooru.org/images/3070682',
	},

	{
		image: '/gallery-07.webp',
		title: 'Celestia',
		category: 'Digital Illustration',
		original: 'https://derpibooru.org/images/3068056',
	},

	{
		image: '/gallery-08.webp',
		title: 'Cozy Glow Queen',
		category: 'Digital Illustration',
		original: 'https://derpibooru.org/images/2971994',
	},

	{
		image: '/gallery-09.webp',
		title: 'Sunburst',
		category: 'Traditional Illustration',
		original: 'https://derpibooru.org/images/2083238',
	},

	{
		image: '/gallery-10.webp',
		title: 'Radon Bunny',
		category: 'Digital Illustration',
		original: 'https://www.instagram.com/p/B6n-R8FHGED/',
	},

	{
		image: '/gallery-11.webp',
		title: 'Twilight Sparkle Anthro',
		category: 'Digital Illustration',
		original: 'https://www.instagram.com/p/B1v43vYHq-5/',
	},

	{
		image: '/gallery-12.webp',
		title: 'Punk Wolf',
		category: 'Digital Illustration',
		original: 'https://www.instagram.com/p/ByJ8tFjnETh/',
	},
];
---

<!doctype html>

<html lang="en">

	<head>

		<BaseHead
			title="Gallery"
			description="A collection of artwork and illustrations by darkPegasista."
		/>

	</head>


	<body>

		<Header />


		<main class="gallery-page">

			<!-- =========================
			     PAGE HEADING
			     ========================= -->

			<section class="page-heading">

				<h1>
					Gallery
				</h1>

				<p>
					A selection of my artwork and illustrations.
				</p>

			</section>


			<!-- =========================
			     GALLERY GRID
			     ========================= -->

			<section class="gallery-grid">

				{gallery.map((item, index) => (

					<article
						class="gallery-card"
						data-index={index}
					>

						<button
							type="button"
							class="gallery-image-button"
							aria-label={`View ${item.title}`}
							data-image={item.image}
							data-title={item.title}
							data-original={item.original}
						>

							<div class="gallery-image">

								<img
									src={item.image}
									alt={item.title}
									loading="lazy"
								/>

							</div>

						</button>


						<div class="gallery-info">

							<div>

								<h2>
									{item.title}
								</h2>

								<p>
									{item.category}
								</p>

							</div>


							<a
								href={item.original}
								target="_blank"
								rel="noopener noreferrer"
								class="original-link"
							>
								Original ↗
							</a>

						</div>

					</article>

				))}

			</section>

		</main>



		<!-- =========================
		     LIGHTBOX
		     ========================= -->

		<div
			id="gallery-lightbox"
			class="lightbox"
			aria-hidden="true"
		>

			<button
				type="button"
				id="lightbox-close"
				class="lightbox-close"
				aria-label="Close image"
			>
				×
			</button>


			<button
				type="button"
				id="lightbox-previous"
				class="lightbox-navigation previous"
				aria-label="Previous image"
			>
				‹
			</button>


			<div class="lightbox-content">

				<img
					id="lightbox-image"
					src=""
					alt=""
				/>


				<div class="lightbox-caption">

					<span id="lightbox-title">
					</span>


					<span id="lightbox-counter">
					</span>

				</div>

			</div>


			<button
				type="button"
				id="lightbox-next"
				class="lightbox-navigation next"
				aria-label="Next image"
			>
				›
			</button>

		</div>



		<Footer />



		<script>

			const galleryItems =
				Array.from(
					document.querySelectorAll(
						'.gallery-image-button'
					)
				);


			const lightbox =
				document.querySelector(
					'#gallery-lightbox'
				);


			const lightboxImage =
				document.querySelector(
					'#lightbox-image'
				);


			const lightboxTitle =
				document.querySelector(
					'#lightbox-title'
				);


			const lightboxCounter =
				document.querySelector(
					'#lightbox-counter'
				);


			const lightboxClose =
				document.querySelector(
					'#lightbox-close'
				);


			const lightboxPrevious =
				document.querySelector(
					'#lightbox-previous'
				);


			const lightboxNext =
				document.querySelector(
					'#lightbox-next'
				);


			let currentIndex = 0;



			function showImage(index) {

				if (
					galleryItems.length === 0
				) {

					return;

				}


				currentIndex =
					(
						index +
						galleryItems.length
					) %
					galleryItems.length;


				const item =
					galleryItems[currentIndex];


				const image =
					item.dataset.image;


				const title =
					item.dataset.title;


				if (lightboxImage) {

					lightboxImage.src =
						image;

					lightboxImage.alt =
						title || '';

				}


				if (lightboxTitle) {

					lightboxTitle.textContent =
						title || '';

				}


				if (lightboxCounter) {

					lightboxCounter.textContent =
						`${currentIndex + 1} / ${galleryItems.length}`;

				}

			}



			function openLightbox(index) {

				showImage(index);


				lightbox?.classList.add(
					'open'
				);


				lightbox?.setAttribute(
					'aria-hidden',
					'false'
				);


				document.body.style.overflow =
					'hidden';

			}



			function closeLightbox() {

				lightbox?.classList.remove(
					'open'
				);


				lightbox?.setAttribute(
					'aria-hidden',
					'true'
				);


				document.body.style.overflow =
					'';

			}



			galleryItems.forEach(
				(item, index) => {

					item.addEventListener(
						'click',
						() => {

							openLightbox(index);

						}
					);

				}
			);



			lightboxClose?.addEventListener(
				'click',
				closeLightbox
			);



			lightboxPrevious?.addEventListener(
				'click',
				() => {

					showImage(
						currentIndex - 1
					);

				}
			);



			lightboxNext?.addEventListener(
				'click',
				() => {

					showImage(
						currentIndex + 1
					);

				}
			);



			lightbox?.addEventListener(
				'click',
				(event) => {

					if (
						event.target === lightbox
					) {

						closeLightbox();

					}

				}
			);



			document.addEventListener(
				'keydown',
				(event) => {

					if (
						!lightbox?.classList.contains(
							'open'
						)
					) {

						return;

					}


					if (
						event.key === 'Escape'
					) {

						closeLightbox();

					}


					if (
						event.key === 'ArrowLeft'
					) {

						showImage(
							currentIndex - 1
						);

					}


					if (
						event.key === 'ArrowRight'
					) {

						showImage(
							currentIndex + 1
						);

					}

				}
			);

		</script>

	</body>

</html>



<style>

/* =========================
   PAGE
   ========================= */

.gallery-page {

	max-width: 1100px;

	margin: 0 auto;

	padding:
		4rem 1.5rem
		6rem;

}



/* =========================
   HEADING
   ========================= */

.page-heading {

	text-align: center;

	margin-bottom:
		3rem;

}


.page-heading h1 {

	margin: 0;

	font-size:
		clamp(3rem, 8vw, 5rem);

	line-height: 1;

	letter-spacing:
		-0.03em;

}


.page-heading p {

	margin:
		1rem 0 0;

	color:
		var(--text-muted);

	font-size:
		1rem;

}



/* =========================
   GALLERY GRID
   ========================= */

.gallery-grid {

	display: grid;

	grid-template-columns:
		repeat(3, 1fr);

	gap:
		1.5rem;

}



/* =========================
   GALLERY CARD
   ========================= */

.gallery-card {

	overflow: hidden;

	border-radius:
		22px;

	border:
		1px solid
		rgba(255, 130, 225, 0.3);

	background:
		linear-gradient(
			145deg,
			rgba(180, 20, 150, 0.15),
			rgba(40, 10, 50, 0.25)
		);

	box-shadow:
		0 0 15px
		rgba(255, 80, 200, 0.06);

	transition:
		transform 0.25s ease,
		border-color 0.25s ease,
		box-shadow 0.25s ease;

}


.gallery-card:hover {

	transform:
		translateY(-5px);

	border-color:
		rgba(255, 130, 225, 0.8);

	box-shadow:

		0 0 25px
		rgba(255, 80, 200, 0.3),

		0 0 50px
		rgba(255, 80, 200, 0.1);

}



/* =========================
   IMAGE
   ========================= */

.gallery-image-button {

	display: block;

	width: 100%;

	padding: 0;

	border: 0;

	background: transparent;

	cursor: pointer;

}


.gallery-image {

	display: flex;

	align-items: center;

	justify-content: center;

	min-height:
		320px;

	padding:
		0.7rem;

	background:
		rgba(0, 0, 0, 0.12);

}


.gallery-image img {

	display: block;

	width: 100%;

	height: auto;

	max-height:
		500px;

	object-fit: contain;

	transition:
		transform 0.35s ease;

}


.gallery-card:hover
.gallery-image img {

	transform:
		scale(1.025);

}



/* =========================
   INFO
   ========================= */

.gallery-info {

	display: flex;

	align-items: center;

	justify-content: space-between;

	gap: 1rem;

	padding:
		1rem 1.1rem
		1.1rem;

}


.gallery-info h2 {

	margin: 0;

	font-size:
		1rem;

	line-height: 1.2;

}


.gallery-info p {

	margin:
		0.3rem 0 0;

	color:
		var(--text-muted);

	font-size:
		0.75rem;

}


.original-link {

	flex-shrink: 0;

	color:
		var(--pink-light);

	font-size:
		0.72rem;

	text-decoration:
		none;

	white-space:
		nowrap;

}


.original-link:hover {

	text-decoration:
		underline;

}



/* =========================
   LIGHTBOX
   ========================= */

.lightbox {

	position: fixed;

	inset: 0;

	z-index: 1000;

	display: flex;

	align-items: center;

	justify-content: center;

	padding:
		3rem;

	background:
		rgba(10, 3, 15, 0.92);

	backdrop-filter:
		blur(12px);

	opacity: 0;

	visibility: hidden;

	transition:
		opacity 0.2s ease,
		visibility 0.2s ease;

}


.lightbox.open {

	opacity: 1;

	visibility: visible;

}


.lightbox-content {

	position: relative;

	display: flex;

	flex-direction: column;

	align-items: center;

	max-width:
		90vw;

	max-height:
		90vh;

}


.lightbox-content img {

	display: block;

	max-width:
		90vw;

	max-height:
		82vh;

	width: auto;

	height: auto;

	object-fit: contain;

	border-radius:
		10px;

	box-shadow:
		0 0 40px
		rgba(255, 80, 200, 0.2);

}


.lightbox-caption {

	display: flex;

	justify-content: space-between;

	width: 100%;

	margin-top:
		0.8rem;

	color:
		rgba(255, 255, 255, 0.85);

	font-size:
		0.8rem;

}


#lightbox-counter {

	color:
		var(--text-muted);

}



/* =========================
   LIGHTBOX CONTROLS
   ========================= */

.lightbox-close {

	position: absolute;

	top:
		1.2rem;

	right:
		1.5rem;

	z-index: 2;

	width:
		45px;

	height:
		45px;

	border:
		1px solid
		rgba(255, 130, 225, 0.5);

	border-radius:
		50%;

	background:
		rgba(80, 10, 80, 0.5);

	color:
		white;

	font-size:
		2rem;

	line-height: 1;

	cursor:
		pointer;

}


.lightbox-navigation {

	position: absolute;

	top: 50%;

	z-index: 2;

	width:
		50px;

	height:
		50px;

	transform:
		translateY(-50%);

	border:
		1px solid
		rgba(255, 130, 225, 0.5);

	border-radius:
		50%;

	background:
		rgba(80, 10, 80, 0.5);

	color:
		white;

	font-size:
		2.2rem;

	line-height: 1;

	cursor:
		pointer;

}


.lightbox-navigation:hover,
.lightbox-close:hover {

	border-color:
		rgba(255, 130, 225, 0.9);

	background:
		rgba(180, 20, 150, 0.35);

	box-shadow:
		0 0 15px
		rgba(255, 80, 200, 0.3);

}


.lightbox-navigation.previous {

	left:
		1.5rem;

}


.lightbox-navigation.next {

	right:
		1.5rem;

}



/* =========================
   MOBILE
   ========================= */

@media (max-width: 850px) {

	.gallery-grid {

		grid-template-columns:
			repeat(2, 1fr);

	}

}


@media (max-width: 600px) {

	.gallery-page {

		padding:
			2.5rem 0.8rem
			4rem;

	}


	.gallery-grid {

		grid-template-columns:
			1fr;

		gap:
			1rem;

	}


	.gallery-image {

		min-height:
			250px;

	}


	.gallery-info {

		padding:
			0.9rem;

	}


	.lightbox {

		padding:
			1rem;

	}


	.lightbox-navigation {

		width:
			40px;

		height:
			40px;

	}


	.lightbox-navigation.previous {

		left:
			0.5rem;

	}


	.lightbox-navigation.next {

		right:
			0.5rem;

	}

}

</style>
