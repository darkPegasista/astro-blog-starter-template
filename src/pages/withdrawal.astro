---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>

<html lang="en">

	<head>

		<BaseHead
			title="Withdrawal Information"
			description="Information about the right of withdrawal for Lunar Visuals."
		/>

	</head>


	<body>

		<Header />


		<main class="legal-page">


			<section class="page-heading">

				<p class="eyebrow">
					✦ LEGAL INFORMATION ✦
				</p>

				<h1>
					Withdrawal
				</h1>

				<p class="intro">
					Information about your statutory right of withdrawal
					when purchasing products or commissioning artwork.
				</p>

			</section>



			<!-- =========================
			     RIGHT OF WITHDRAWAL
			     ========================= -->

			<section class="legal-card">

				<span class="section-label">
					01
				</span>

				<h2>
					Right of Withdrawal
				</h2>

				<p>
					Consumers generally have a statutory right of
					withdrawal for contracts concluded at a distance.
					The withdrawal period is generally 14 days.
				</p>

				<p>
					The following information explains how the right
					of withdrawal applies to purchases and commissions
					offered by Lunar Visuals.
				</p>

			</section>



			<!-- =========================
			     HOW TO WITHDRAW
			     ========================= -->

			<section class="legal-card">

				<span class="section-label">
					02
				</span>

				<h2>
					How to Exercise Your Withdrawal
				</h2>

				<p>
					To exercise your right of withdrawal, please send
					a clear statement informing me of your decision
					to withdraw from the contract.
				</p>

				<p>
					You may contact me by email:
				</p>

				<p>
					<strong>
						Email:
					</strong>

					<a href="mailto:lunar.dash.visuals@gmail.com">
						lunar.dash.visuals@gmail.com
					</a>
				</p>

				<p>
					You may use the model withdrawal form provided
					below, but you are not required to do so.
				</p>

			</section>



			<!-- =========================
			     COMMISSIONS
			     ========================= -->

			<section class="legal-card">

				<span class="section-label">
					03
				</span>

				<h2>
					Custom Artwork Commissions
				</h2>

				<p>
					Commissioned artwork is created individually
					according to the customer's specifications.
				</p>

				<p>
					If you wish to cancel a commission, please contact
					me as soon as possible.
				</p>

				<p>
					You may withdraw from the commission as long as
					I have not yet started working on it.
				</p>

				<p>
					Once work on a commission has started, the statutory
					right of withdrawal may be affected by the nature
					of the individually commissioned work and by any
					express request to begin performance before the
					withdrawal period has expired.
				</p>

				<p>
					For this reason, please contact me immediately if
					you wish to cancel a commission.
				</p>

			</section>



			<!-- =========================
			     DIGITAL CONTENT
			     ========================= -->

			<section class="legal-card">

				<span class="section-label">
					04
				</span>

				<h2>
					Digital Artwork
				</h2>

				<p>
					Digital artwork is supplied electronically and is
					created specifically for the customer.
				</p>

				<p>
					If you expressly request that I begin performing
					the service before the end of the statutory
					withdrawal period, you acknowledge that the
					conditions applicable to services and digital
					content supplied during the withdrawal period may
					apply.
				</p>

				<p>
					Any required consent or acknowledgement will be
					obtained separately as part of the ordering process.
				</p>

			</section>



			<!-- =========================
			     PHYSICAL CUSTOM ARTWORK
			     ========================= -->

			<section class="legal-card">

				<span class="section-label">
					05
				</span>

				<h2>
					Traditional / Physical Artwork
				</h2>

				<p>
					Traditional artwork commissioned according to
					your individual specifications is produced
					specifically for you.
				</p>

				<p>
					For individually made goods that are not
					prefabricated and are made according to the
					consumer's individual choice or specification,
					the statutory right of withdrawal may be excluded
					where the applicable legal requirements are met.
				</p>

			</section>



			<!-- =========================
			     REFUNDS
			     ========================= -->

			<section class="legal-card">

				<span class="section-label">
					06
				</span>

				<h2>
					Refunds
				</h2>

				<p>
					If a withdrawal is validly exercised, payments
					received will generally be refunded in accordance
					with the applicable statutory requirements.
				</p>

				<p>
					The refund will normally be made using the same
					payment method that was used for the original
					transaction, unless another arrangement has been
					expressly agreed.
				</p>

			</section>



			<!-- =========================
			     MODEL FORM
			     ========================= -->

			<section class="legal-card">

				<span class="section-label">
					07
				</span>

				<h2>
					Model Withdrawal Form
				</h2>

				<p>
					If you wish to withdraw from a contract, you may
					use the following form:
				</p>

				<div class="form-box">

					<p>
						To:
					</p>

					<details class="address-details">

						<summary>
							Business address
						</summary>

						<div class="address">

							Lunar Visuals<br />
							Daria Klokova<br />
							Kronenstrasse 18B<br />
							79618 Rheinfelden (Baden)<br />
							Germany

						</div>

					</details>


					<p>
						Email:
						<a href="mailto:lunar.dash.visuals@gmail.com">
							lunar.dash.visuals@gmail.com
						</a>
					</p>


					<p>
						I/We hereby give notice that I/We withdraw
						from my/our contract for the purchase of the
						following goods / the provision of the following
						service:
					</p>


					<p>
						<strong>
							Ordered on / received on:
						</strong>
					</p>


					<p>
						<strong>
							Name of consumer(s):
						</strong>
					</p>


					<p>
						<strong>
							Address of consumer(s):
						</strong>
					</p>


					<p>
						<strong>
							Date:
						</strong>
					</p>


					<p class="small-note">
						Signature only required if this form is submitted
						on paper.
					</p>

				</div>

			</section>



			<!-- =========================
			     PROVIDER
			     ========================= -->

			<section class="legal-card">

				<span class="section-label">
					08
				</span>

				<h2>
					Provider
				</h2>

				<p class="business-name">
					Lunar Visuals
				</p>

				<p>
					Daria Klokova
				</p>

				<details class="address-details">

					<summary>
						Business address
					</summary>

					<div class="address">

						Kronenstrasse 18B<br />
						79618 Rheinfelden (Baden)<br />
						Germany

					</div>

				</details>

			</section>



			<section class="last-updated">

				<p>
					Last updated: 04.09.2026
				</p>

			</section>


		</main>


		<Footer />

	</body>

</html>



<style>

.legal-page {

	max-width:
		900px;

	margin:
		0 auto;

	padding:
		4rem 1.5rem
		6rem;

}


.page-heading {

	text-align:
		center;

	margin-bottom:
		3rem;

}


.eyebrow {

	margin:
		0 0 0.7rem;

	color:
		var(--pink-light);

	font-size:
		0.7rem;

	font-weight:
		700;

	letter-spacing:
		0.16em;

}


.page-heading h1 {

	margin:
		0;

	font-size:
		clamp(3rem, 8vw, 5rem);

	line-height:
		1;

	letter-spacing:
		-0.03em;

}


.intro {

	max-width:
		650px;

	margin:
		1rem auto 0;

	color:
		var(--text-muted);

	font-size:
		1rem;

	line-height:
		1.6;

}


.legal-card {

	margin-bottom:
		1.2rem;

	padding:
		2rem;

	border:
		1px solid
		rgba(255, 130, 225, 0.28);

	border-radius:
		22px;

	background:
		linear-gradient(
			145deg,
			rgba(180, 20, 150, 0.14),
			rgba(40, 10, 50, 0.22)
		);

	box-shadow:
		0 0 18px
		rgba(255, 80, 200, 0.05);

}


.section-label {

	display:
		inline-block;

	margin-bottom:
		0.7rem;

	color:
		var(--pink-light);

	font-size:
		0.7rem;

	font-weight:
		700;

	letter-spacing:
		0.12em;

}


.legal-card h2 {

	margin:
		0 0 1rem;

	font-size:
		1.5rem;

}


.legal-card p {

	margin:
		0 0 1rem;

	color:
		var(--text-muted);

	font-size:
		0.92rem;

	line-height:
		1.65;

}


.legal-card p:last-child {

	margin-bottom:
		0;

}


.business-name {

	color:
		white !important;

	font-size:
		1.1rem !important;

	font-weight:
		700;

}


.address-details {

	margin-top:
		1.2rem;

}


.address-details summary {

	display:
		inline-block;

	cursor:
		pointer;

	color:
		var(--pink-light);

	font-size:
		0.9rem;

	font-weight:
		600;

	list-style:
		none;

}


.address-details summary::-webkit-details-marker {

	display:
		none;

}


.address-details summary::before {

	content:
		"▸";

	display:
		inline-block;

	margin-right:
		0.5rem;

	transition:
		transform 0.2s ease;

}


.address-details[open]
summary::before {

	transform:
		rotate(90deg);

}


.address-details summary:hover {

	color:
		white;

}


.address {

	margin-top:
		1rem;

	padding:
		1rem 1.2rem;

	border:
		1px solid
		rgba(255, 130, 225, 0.2);

	border-radius:
		12px;

	background:
		rgba(255, 255, 255, 0.03);

	color:
		var(--text-muted);

	font-size:
		0.9rem;

	line-height:
		1.7;

}


.legal-card a {

	color:
		var(--pink-light);

	text-decoration:
		none;

}


.legal-card a:hover {

	color:
		white;

	text-decoration:
		underline;

}


.form-box {

	margin-top:
		1.5rem;

	padding:
		1.3rem;

	border:
		1px solid
		rgba(255, 255, 255, 0.1);

	border-radius:
		14px;

	background:
		rgba(255, 255, 255, 0.025);

}


.form-box p {

	margin-bottom:
		1rem;

}


.form-box p:last-child {

	margin-bottom:
		0;

}


.small-note {

	font-size:
		0.8rem !important;

	font-style:
		italic;

}


.last-updated {

	padding:
		1.5rem;

	text-align:
		center;

	color:
		var(--text-muted);

	font-size:
		0.75rem;

}


@media (max-width: 650px) {

	.legal-page {

		padding:
			2.5rem 0.8rem
			4rem;

	}


	.legal-card {

		padding:
			1.4rem;

		border-radius:
			18px;

	}


	.legal-card h2 {

		font-size:
			1.3rem;

	}


	.legal-card p {

		font-size:
			0.88rem;

	}

}

</style>
