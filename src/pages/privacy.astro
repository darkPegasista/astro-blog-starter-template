---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>

<html lang="en">

	<head>

		<BaseHead
			title="Privacy Policy"
			description="Privacy Policy for lunar visuals."
		/>

	</head>


	<body>

		<Header />


		<main class="legal-page">


			<!-- =========================
			     PAGE HEADING
			     ========================= -->

			<section class="page-heading">

				<p class="eyebrow">
					✦ LEGAL INFORMATION ✦
				</p>

				<h1>
					Privacy Policy
				</h1>

				<p class="intro">
					Information about the processing of personal data
					when using the Lunar Visuals website.
				</p>

			</section>



			<!-- =========================
			     CONTROLLER
			     ========================= -->

			<section class="legal-card">

				<span class="section-label">
					01
				</span>

				<h2>
					Controller
				</h2>


				<p class="business-name">
					Lunar Visuals
				</p>


				<p>
					Daria Klokova
				</p>


				<details class="address-details">

					<summary>
						Business address
					</summary>


					<div class="address">

						Kronenstrasse 18B<br />
						79618 Rheinfelden (Baden)<br />
						Germany

					</div>

				</details>


				<p>
					<strong>
						Email:
					</strong>

					<a href="mailto:lunar.dash.visuals@gmail.com">
						lunar.dash.visuals@gmail.com
					</a>
				</p>

			</section>



			<!-- =========================
			     GENERAL INFORMATION
			     ========================= -->

			<section class="legal-card">

				<span class="section-label">
					02
				</span>

				<h2>
					General Information
				</h2>


				<p>
					I process personal data only to the extent necessary
					to operate this website, respond to inquiries,
					process orders and commissions, provide requested
					services, and comply with legal obligations.
				</p>


				<p>
					Personal data is not sold or rented to third parties.
				</p>

			</section>



			<!-- =========================
			     WEBSITE ACCESS
			     ========================= -->

			<section class="legal-card">

				<span class="section-label">
					03
				</span>

				<h2>
					Visiting the Website
				</h2>


				<p>
					When you access this website, technical information
					may be processed by the hosting and infrastructure
					provider. This may include information such as the
					requested URL, date and time of the request, browser
					and device information, and technical information
					required to deliver and secure the website.
				</p>


				<p>
					This processing is carried out to provide the website,
					maintain its security and stability, and protect it
					against misuse.
				</p>

			</section>



			<!-- =========================
			     CLOUDFLARE
			     ========================= -->

			<section class="legal-card">

				<span class="section-label">
					04
				</span>

				<h2>
					Cloudflare
				</h2>


				<p>
					This website uses services provided by Cloudflare
					for hosting, infrastructure, security and website
					performance.
				</p>


				<p>
					The website also uses Cloudflare Web Analytics to
					understand how the website performs for visitors.
					Cloudflare states that Web Analytics does not use
					cookies or local storage and does not collect or use
					visitors' personal data for its analytics service.
				</p>


				<p>
					Cloudflare may nevertheless process technical
					information as part of providing its infrastructure
					and security services.
				</p>

			</section>



			<!-- =========================
			     SHOPPING CART
			     ========================= -->

			<section class="legal-card">

				<span class="section-label">
					05
				</span>

				<h2>
					Shopping Cart
				</h2>


				<p>
					The website uses your browser's local storage
					(localStorage) to temporarily store the contents
					of your shopping cart.
				</p>


				<p>
					This information is stored locally in your browser
					and is used solely to provide the shopping cart
					functionality requested by you.
				</p>


				<p>
					The cart data is not used for advertising or
					behavioral tracking.
				</p>

			</section>



			<!-- =========================
			     STRIPE
			     ========================= -->

			<section class="legal-card">

				<span class="section-label">
					06
				</span>

				<h2>
					Payments
				</h2>


				<p>
					Payments for products purchased through this website
					are processed using Stripe Checkout.
				</p>


				<p>
					When you proceed to payment, information required
					to process the transaction is transmitted to Stripe.
					This may include your name, email address, billing
					and shipping information, payment information and
					transaction details.
				</p>


				<p>
					Stripe processes this information as an independent
					service provider in accordance with its own privacy
					policy and applicable data protection requirements.
				</p>


				<p>
					I do not receive or store your complete payment card
					number or card security code.
				</p>

			</section>



			<!-- =========================
			     CONTACT
			     ========================= -->

			<section class="legal-card">

				<span class="section-label">
					07
				</span>

				<h2>
					Contacting Me
				</h2>


				<p>
					If you contact me by email, the information contained
					in your message and the contact details you provide
					will be processed in order to respond to your request.
				</p>


				<p>
					The information will be retained only for as long as
					necessary to handle the request or where retention is
					required for legal or contractual reasons.
				</p>


				<p>
					<strong>
						Email:
					</strong>

					<a href="mailto:lunar.dash.visuals@gmail.com">
						lunar.dash.visuals@gmail.com
					</a>
				</p>

			</section>



			<!-- =========================
			     ORDERS AND COMMISSIONS
			     ========================= -->

			<section class="legal-card">

				<span class="section-label">
					08
				</span>

				<h2>
					Orders and Commissions
				</h2>


				<p>
					If you purchase merchandise or commission artwork,
					I process the personal information necessary to
					fulfil the order or commission.
				</p>


				<p>
					This may include your name, contact details,
					delivery address, order information, payment-related
					transaction information and information necessary
					to create your commissioned artwork.
				</p>


				<p>
					The processing is carried out for the performance
					of the contract, for compliance with legal
					obligations and, where applicable, on the basis
					of legitimate interests.
				</p>

			</section>



			<!-- =========================
			     LEGAL BASES
			     ========================= -->

			<section class="legal-card">

				<span class="section-label">
					09
				</span>

				<h2>
					Legal Bases
				</h2>


				<p>
					Depending on the circumstances, personal data may
					be processed on the following legal bases under
					Article 6 GDPR:
				</p>


				<ul>

					<li>
						Article 6(1)(b) GDPR — processing necessary
						for the performance of a contract or to take
						steps at your request before entering into a
						contract.
					</li>

					<li>
						Article 6(1)(c) GDPR — processing necessary
						for compliance with legal obligations.
					</li>

					<li>
						Article 6(1)(f) GDPR — processing necessary
						for legitimate interests, such as maintaining
						the security and functionality of the website.
					</li>

					<li>
						Article 6(1)(a) GDPR — where processing is
						based on your consent.
					</li>

				</ul>

			</section>



			<!-- =========================
			     RECIPIENTS
			     ========================= -->

			<section class="legal-card">

				<span class="section-label">
					10
				</span>

				<h2>
					Recipients of Personal Data
				</h2>


				<p>
					Personal data may be disclosed to service providers
					where this is necessary to operate the website or
					perform a contract.
				</p>


				<p>
					Depending on the service involved, this may include
					Cloudflare for website infrastructure and security
					and Stripe for payment processing.
				</p>


				<p>
					Personal data may also be disclosed to authorities
					or other recipients where I am legally required
					to do so.
				</p>

			</section>



			<!-- =========================
			     INTERNATIONAL TRANSFERS
			     ========================= -->

			<section class="legal-card">

				<span class="section-label">
					11
				</span>

				<h2>
					International Data Transfers
				</h2>


				<p>
					Some service providers used by this website may
					process personal data outside the European Economic
					Area.
				</p>


				<p>
					Where personal data is transferred to a country
					outside the EEA, the transfer is carried out in
					accordance with the applicable requirements of
					Chapter V GDPR, including where appropriate an
					adequacy decision or suitable safeguards.
				</p>

			</section>



			<!-- =========================
			     RETENTION
			     ========================= -->

			<section class="legal-card">

				<span class="section-label">
					12
				</span>

				<h2>
					Storage and Retention
				</h2>


				<p>
					Personal data is retained only for as long as
					necessary for the respective purpose or where
					statutory retention obligations require longer
					storage.
				</p>


				<p>
					After the applicable retention period has expired,
					the data will be deleted unless further processing
					is legally required or permitted.
				</p>

			</section>



			<!-- =========================
			     YOUR RIGHTS
			     ========================= -->

			<section class="legal-card">

				<span class="section-label">
					13
				</span>

				<h2>
					Your Rights
				</h2>


				<p>
					Subject to the applicable legal requirements, you
					have the following rights under the GDPR:
				</p>


				<ul>

					<li>
						Right of access to your personal data.
					</li>

					<li>
						Right to rectification of inaccurate data.
					</li>

					<li>
						Right to erasure of your personal data.
					</li>

					<li>
						Right to restriction of processing.
					</li>

					<li>
						Right to data portability.
					</li>

					<li>
						Right to object to certain processing.
					</li>

					<li>
						Right to withdraw consent where processing
						is based on consent.
					</li>

				</ul>


				<p>
					To exercise any of these rights, please contact me
					using the email address provided above.
				</p>

			</section>



			<!-- =========================
			     COMPLAINT
			     ========================= -->

			<section class="legal-card">

				<span class="section-label">
					14
				</span>

				<h2>
					Right to Lodge a Complaint
				</h2>


				<p>
					You have the right to lodge a complaint with a
					data protection supervisory authority if you believe
					that the processing of your personal data violates
					applicable data protection law.
				</p>

			</section>



			<!-- =========================
			     COOKIES
			     ========================= -->

			<section class="legal-card">

				<span class="section-label">
					15
				</span>

				<h2>
					Cookies
				</h2>


				<p>
					This website does not use cookies for advertising
					or behavioral tracking.
				</p>


				<p>
					Cloudflare Web Analytics does not use cookies or
					local storage for its analytics functionality.
				</p>


				<p>
					Other cookies or similar technologies may be used
					by third-party services when you interact with
					their services, such as the payment environment
					provided by Stripe. Such technologies are subject
					to the respective provider's privacy information.
				</p>

			</section>



			<!-- =========================
			     PROVIDER
			     ========================= -->

			<section class="legal-card">

				<span class="section-label">
					16
				</span>

				<h2>
					Provider
				</h2>


				<p class="business-name">
					Lunar Visuals
				</p>


				<p>
					Daria Klokova
				</p>


				<details class="address-details">

					<summary>
						Business address
					</summary>


					<div class="address">

						Kronenstrasse 18B<br />
						79618 Rheinfelden (Baden)<br />
						Germany

					</div>

				</details>

			</section>



			<section class="last-updated">

				<p>
					Last updated: 04.09.2026
				</p>

			</section>


		</main>


		<Footer />

	</body>

</html>



<style>

/* =========================
   PAGE
   ========================= */

.legal-page {

	max-width:
		900px;

	margin:
		0 auto;

	padding:
		4rem 1.5rem
		6rem;

}



/* =========================
   HEADING
   ========================= */

.page-heading {

	text-align:
		center;

	margin-bottom:
		3rem;

}


.eyebrow {

	margin:
		0 0 0.7rem;

	color:
		var(--pink-light);

	font-size:
		0.7rem;

	font-weight:
		700;

	letter-spacing:
		0.16em;

}


.page-heading h1 {

	margin:
		0;

	font-size:
		clamp(3rem, 8vw, 5rem);

	line-height:
		1;

	letter-spacing:
		-0.03em;

}


.intro {

	max-width:
		650px;

	margin:
		1rem auto 0;

	color:
		var(--text-muted);

	font-size:
		1rem;

	line-height:
		1.6;

}



/* =========================
   CARDS
   ========================= */

.legal-card {

	margin-bottom:
		1.2rem;

	padding:
		2rem;

	border:
		1px solid
		rgba(255, 130, 225, 0.28);

	border-radius:
		22px;

	background:
		linear-gradient(
			145deg,
			rgba(180, 20, 150, 0.14),
			rgba(40, 10, 50, 0.22)
		);

	box-shadow:
		0 0 18px
		rgba(255, 80, 200, 0.05);

}


.section-label {

	display:
		inline-block;

	margin-bottom:
		0.7rem;

	color:
		var(--pink-light);

	font-size:
		0.7rem;

	font-weight:
		700;

	letter-spacing:
		0.12em;

}


.legal-card h2 {

	margin:
		0 0 1rem;

	font-size:
		1.5rem;

}


.legal-card p {

	margin:
		0 0 1rem;

	color:
		var(--text-muted);

	font-size:
		0.92rem;

	line-height:
		1.65;

}


.legal-card p:last-child {

	margin-bottom:
		0;

}


.business-name {

	color:
		white !important;

	font-size:
		1.1rem !important;

	font-weight:
		700;

}



/* =========================
   LISTS
   ========================= */

.legal-card ul {

	margin:
		0 0 1rem;

	padding-left:
		1.4rem;

	color:
		var(--text-muted);

	font-size:
		0.92rem;

	line-height:
		1.7;

}


.legal-card li {

	margin-bottom:
		0.55rem;

}


.legal-card li:last-child {

	margin-bottom:
		0;

}



/* =========================
   ADDRESS
   ========================= */

.address-details {

	margin-top:
		1.2rem;

}


.address-details summary {

	display:
		inline-block;

	cursor:
		pointer;

	color:
		var(--pink-light);

	font-size:
		0.9rem;

	font-weight:
		600;

	list-style:
		none;

}


.address-details summary::-webkit-details-marker {

	display:
		none;

}


.address-details summary::before {

	content:
		"▸";

	display:
		inline-block;

	margin-right:
		0.5rem;

	transition:
		transform 0.2s ease;

}


.address-details[open]
summary::before {

	transform:
		rotate(90deg);

}


.address-details summary:hover {

	color:
		white;

}


.address {

	margin-top:
		1rem;

	padding:
		1rem 1.2rem;

	border:
		1px solid
		rgba(255, 130, 225, 0.2);

	border-radius:
		12px;

	background:
		rgba(255, 255, 255, 0.03);

	color:
		var(--text-muted);

	font-size:
		0.9rem;

	line-height:
		1.7;

}



/* =========================
   LINKS
   ========================= */

.legal-card a {

	color:
		var(--pink-light);

	text-decoration:
		none;

}


.legal-card a:hover {

	color:
		white;

	text-decoration:
		underline;

}



/* =========================
   LAST UPDATED
   ========================= */

.last-updated {

	padding:
		1.5rem;

	text-align:
		center;

	color:
		var(--text-muted);

	font-size:
		0.75rem;

}



/* =========================
   MOBILE
   ========================= */

@media (max-width: 650px) {

	.legal-page {

		padding:
			2.5rem 0.8rem
			4rem;

	}


	.legal-card {

		padding:
			1.4rem;

		border-radius:
			18px;

	}


	.legal-card h2 {

		font-size:
			1.3rem;

	}


	.legal-card p,
	.legal-card ul {

		font-size:
			0.88rem;

	}

}

</style>
