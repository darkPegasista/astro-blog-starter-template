---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<!doctype html>

<html lang="en">

	<head>

		<BaseHead
			title="Order Complete"
			description="Your Lunar Visuals order has been completed successfully."
		/>

	</head>


	<body>

		<Header />


		<main>

			<section class="success-card">

				<div class="success-icon">
					✦
				</div>


				<h1>
					Order complete!
				</h1>


				<p class="success-message">

					Thank you for your order!

					<br />

					Your payment was successful and your
					order has been received.

				</p>


				<p class="shipping-message">

					I'll prepare your order for shipping
					and send you the tracking information
					once it has been dispatched.

				</p>


				<div class="success-divider"></div>


				<a
					href="/"
					class="home-button"
				>
					Back to Home
				</a>

			</section>

		</main>


		<Footer />


		<style>

			/* =========================
			   PAGE
			   ========================= */

			main {

				max-width: 900px;

				min-height: 60vh;

				margin: 0 auto;

				padding:
					5rem 1.5rem
					6rem;

				display: flex;

				align-items: center;

				justify-content: center;

			}


			/* =========================
			   SUCCESS CARD
			   ========================= */

			.success-card {

				width: 100%;

				max-width: 650px;

				padding:
					4rem 3rem;

				border-radius: 30px;

				border:
					1px solid
					var(--card-border);

				background:
					linear-gradient(
						145deg,
						rgba(180, 20, 150, 0.22),
						rgba(40, 10, 50, 0.24)
					);

				box-shadow:

					0 0 25px
					rgba(255, 80, 200, 0.12),

					inset 0 0 30px
					rgba(255, 80, 200, 0.04);

				backdrop-filter:
					blur(12px);

				text-align:
					center;

			}


			/* =========================
			   ICON
			   ========================= */

			.success-icon {

				margin-bottom:
					1rem;

				font-size:
					2.5rem;

				color:
					var(--pink-light);

				text-shadow:

					0 0 10px
					rgba(255, 100, 220, 0.8),

					0 0 25px
					rgba(255, 80, 200, 0.35);

			}


			/* =========================
			   HEADING
			   ========================= */

			.success-card h1 {

				margin:
					0;

				font-size:
					clamp(2.2rem, 6vw, 3.5rem);

				line-height:
					1.1;

			}


			/* =========================
			   TEXT
			   ========================= */

			.success-message {

				margin:
					1.5rem auto 0;

				max-width:
					500px;

				color:
					var(--text);

				font-size:
					1.1rem;

				line-height:
					1.7;

			}


			.shipping-message {

				margin:
					1.2rem auto 0;

				max-width:
					500px;

				color:
					var(--text-muted);

				font-size:
					0.95rem;

				line-height:
					1.6;

			}


			/* =========================
			   DIVIDER
			   ========================= */

			.success-divider {

				width:
					100%;

				height:
					1px;

				margin:
					2rem 0;

				background:
					rgba(255, 130, 225, 0.25);

			}


			/* =========================
			   BUTTON
			   ========================= */

			.home-button {

				display:
					inline-flex;

				align-items:
					center;

				justify-content:
					center;

				min-width:
					200px;

				padding:
					0.9rem 1.5rem;

				border-radius:
					12px;

				border:
					1px solid
					rgba(255, 130, 225, 0.65);

				background:
					rgba(255, 70, 200, 0.08);

				color:
					white;

				font-family:
					inherit;

				font-size:
					1rem;

				font-weight:
					600;

				text-decoration:
					none;

				box-shadow:
					0 0 10px
					rgba(255, 80, 200, 0.08);

				transition:
					transform 0.2s ease,
					background 0.2s ease,
					border-color 0.2s ease,
					box-shadow 0.2s ease;

			}


			.home-button:hover {

				transform:
					translateY(-2px);

				border-color:
					rgba(255, 130, 225, 0.95);

				background:
					rgba(255, 70, 200, 0.14);

				box-shadow:

					0 0 15px
					rgba(255, 80, 200, 0.35),

					0 0 35px
					rgba(255, 80, 200, 0.12);

			}


			/* =========================
			   MOBILE
			   ========================= */

			@media (max-width: 700px) {

				main {

					padding:
						3rem 0.8rem
						4rem;

				}


				.success-card {

					padding:
						3rem 1.5rem;

					border-radius:
						22px;

				}


				.success-message {

					font-size:
						1rem;

				}

			}

		</style>

	</body>

</html>
