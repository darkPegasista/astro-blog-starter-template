---
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const navigation = [
	{
		name: 'Home',
		href: '/',
	},
	{
		name: 'Commissions',
		href: '/commissions',
	},
	{
		name: 'Merch',
		href: '/merch',
	},
	{
		name: 'Gallery',
		href: '/gallery',
	},
	{
		name: 'Terms',
		href: '/terms',
	},
];
---

<header class="site-header">

	<nav>

		<div class="navigation-links">

			{navigation.map((item) => (

				<a
					href={item.href}
					class:list={{ active: currentPath === item.href }}
				>
					{item.name}
				</a>

			))}

		</div>


		<!-- CART -->

		<a
			href="/cart"
			class="cart-link"
			aria-label="Shopping cart"
		>

			<span class="cart-icon">
				🛒
			</span>

			<span
				id="cart-count"
				class="cart-count"
			>
				0
			</span>

		</a>

	</nav>

</header>



<script>

	// =========================
	// UPDATE CART COUNT
	// =========================

	function updateCartCount() {

		const cart =
			JSON.parse(
				localStorage.getItem('cart') || '[]'
			);


		const totalItems =
			cart.reduce(
				(total, item) =>
					total + item.quantity,
				0
			);


		const cartCount =
			document.querySelector('#cart-count');


		if (cartCount) {

			cartCount.textContent =
				String(totalItems);

		}

	}


	updateCartCount();


	window.addEventListener(
		'storage',
		updateCartCount
	);

</script>



<style>

	.site-header {

		width: 100%;

		padding:
			2rem 1.5rem 0;

	}


	nav {

		max-width:
			900px;

		margin:
			0 auto;

		display:
			flex;

		justify-content:
			center;

		align-items:
			center;

		gap:
			2.5rem;

		padding:
			1rem 2rem;

		border:
			1px solid
			rgba(255, 112, 209, 0.55);

		border-radius:
			999px;

		background:
			rgba(120, 20, 100, 0.18);

		box-shadow:
			0 0 15px
			rgba(255, 80, 200, 0.15),

			inset 0 0 20px
			rgba(255, 80, 200, 0.05);

		backdrop-filter:
			blur(10px);

	}


	/* =========================
	   NAVIGATION
	   ========================= */

	.navigation-links {

		display:
			flex;

		justify-content:
			center;

		align-items:
			center;

		gap:
			2.5rem;

	}


	.navigation-links a {

		position:
			relative;

		color:
			rgba(255, 255, 255, 0.65);

		font-size:
			1rem;

		font-weight:
			500;

		transition:
			color 0.2s ease,
			text-shadow 0.2s ease;

	}


	.navigation-links a:hover,
	.navigation-links a.active {

		color:
			white;

		text-shadow:
			0 0 10px
			rgba(255, 100, 220, 0.8);

	}


	.navigation-links a.active::after {

		content:
			"";

		position:
			absolute;

		left:
			50%;

		bottom:
			-0.65rem;

		width:
			5px;

		height:
			5px;

		transform:
			translateX(-50%);

		border-radius:
			50%;

		background:
			var(--pink-light);

		box-shadow:
			0 0 8px
			var(--pink-light);

	}



	/* =========================
	   CART
	   ========================= */

	.cart-link {

		position:
			relative;

		display:
			flex;

		align-items:
			center;

		justify-content:
			center;

		width:
			38px;

		height:
			38px;

		border-radius:
			50%;

		border:
			1px solid
			rgba(255, 130, 225, 0.45);

		background:
			rgba(255, 255, 255, 0.04);

		color:
			white;

		text-decoration:
			none;

		transition:
			transform 0.2s ease,
			border-color 0.2s ease,
			box-shadow 0.2s ease,
			background 0.2s ease;

	}


	.cart-link:hover {

		transform:
			translateY(-2px);

		border-color:
			rgba(255, 130, 225, 0.9);

		background:
			rgba(255, 70, 200, 0.1);

		box-shadow:
			0 0 18px
			rgba(255, 80, 200, 0.3);

	}


	.cart-icon {

		font-size:
			1rem;

		line-height:
			1;

	}


	.cart-count {

		position:
			absolute;

		right:
			-5px;

		top:
			-5px;

		min-width:
			18px;

		height:
			18px;

		padding:
			0 4px;

		display:
			flex;

		align-items:
			center;

		justify-content:
			center;

		border-radius:
			999px;

		background:
			var(--pink-light);

		color:
			white;

		font-size:
			0.65rem;

		font-weight:
			700;

		line-height:
			1;

		box-shadow:
			0 0 8px
			var(--pink-light);

	}



	/* =========================
	   MOBILE
	   ========================= */

	@media (max-width: 700px) {

		.site-header {

			padding:
				1rem 0.75rem 0;

		}


		nav {

			gap:
				1rem;

			padding:
				0.8rem 1rem;

		}


		.navigation-links {

			gap:
				1rem;

		}


		.navigation-links a {

			font-size:
				0.8rem;

		}


		.cart-link {

			width:
				34px;

			height:
				34px;

		}

	}


	@media (max-width: 480px) {

		nav {

			gap:
				0.65rem;

		}


		.navigation-links {

			gap:
				0.65rem;

		}


		.navigation-links a {

			font-size:
				0.72rem;

		}


		.cart-link {

			width:
				32px;

			height:
				32px;

		}

	}

</style>
